{
  "name": "@weave/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite --host 0.0.0.0 --port 5174",
    "test": "bun --bun run vitest run",
    "typecheck": "bun --bun run tsc -p tsconfig.json",
    "build": "bun --bun run tsc -p tsconfig.json && bun --bun run vite build",
    "check": "bun run test && bun run build",
    "ghostty:web": "bun scripts/ghostty.ts web",
    "ios:build": "bun scripts/ios.ts build",
    "ios:install": "bun scripts/ios.ts install",
    "ios:dev": "bun --bun run tauri ios dev",
    "mac:dev": "bun --bun run tauri dev",
    "mac:install": "bun scripts/mac.ts install",
    "mac:terminal-check": "bun scripts/mac-terminal-check.ts",
    "mac:test": "cargo test --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.0",
    "@streamdown/code": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-deep-link": "2.6.3",
    "@tauri-apps/plugin-notification": "2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "mermaid": "^11.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.19.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^20.11.6",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "katex": "^0.19.1"
  }
}
