    "mobile:dev:coppermind": "npm --prefix mobile run dev:coppermind --",
    "mobile:build": "npm --prefix mobile run build",
    "mobile:build:flare": "npm --prefix mobile run build:flare",
    "mobile:build:coppermind": "npm --prefix mobile run build:coppermind",
    "mobile:cap:sync": "npm --prefix mobile run cap:sync",
