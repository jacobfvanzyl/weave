    "server:perf": "deno task --config server/deno.json perf",
    "server:perf:inspect": "deno task --config server/deno.json perf:inspect",
    "agent:eval": "deno run --config server/deno.json --env-file=server/.env --sloppy-imports --allow-env --allow-net --allow-read --allow-write=.weave-evals --allow-run=git,bash --allow-sys --allow-ffi --node-modules-dir=auto server/src/agent/evals/runner.ts",
    "agent:eval:compare": "deno task agent:eval compare",
    "server:deploy:prepare": "deno task server:build && deno run --allow-env --allow-read=. --allow-write --allow-run=git scripts/dokploy-server.ts prepare",
    "server:deploy": "deno task server:build && deno run --env-file=server/.env.deploy --allow-env --allow-net --allow-read=. --allow-write --allow-run=git,ssh scripts/dokploy-server.ts deploy",
    "server:deploy:status": "deno run --env-file=server/.env.deploy --allow-env --allow-net --allow-read=. --allow-run=git scripts/dokploy-server.ts status",
    "server:deploy:rollback": "deno run --env-file=server/.env.deploy --allow-env --allow-net --allow-read=. --allow-run=git,ssh scripts/dokploy-server.ts rollback",
    "server:deploy:cutover": "deno run --env-file=server/.env.deploy --env-file=server/.env --allow-env --allow-net --allow-read=. --allow-run scripts/dokploy-server.ts cutover",
    "protocol:test": "deno test packages/protocol/src/*_test.ts",
    "server:deploy:test": "deno test --config server/deno.json --sloppy-imports --allow-env --allow-net=127.0.0.1 --allow-read --allow-write --allow-run=git scripts/dokploy-server_test.ts server/src/rpc/rpc_smoke_test.ts server/src/rpc/gateway_test.ts server/src/rpc/binary-transfers_test.ts server/src/rpc/router_test.ts server/src/rpc/portal-status_test.ts server/src/modules/code/rpc_test.ts server/src/storage/copy-object-store_test.ts",
    "server:auth:test": "deno test --config server/deno.json --sloppy-imports --allow-env --allow-net=127.0.0.1 --allow-read server/src/agent/credentials/chatgpt-credential-repository_test.ts server/src/agent/mastra/providers/chatgpt-codex-auth_test.ts server/src/agent/mastra/providers/chatgpt-codex-language-model_test.ts server/src/agent/routes/chatgpt-auth_test.ts",
    "infra:up": "docker compose -p weave -f server/compose.dokploy.yml -f server/compose.local.yml up -d postgres garage ollama",
    "infra:down": "docker compose -p weave -f server/compose.dokploy.yml -f server/compose.local.yml stop postgres garage ollama",
    "infra:ps": "docker compose -p weave -f server/compose.dokploy.yml -f server/compose.local.yml ps",
    "infra:logs": "docker compose -p weave -f server/compose.dokploy.yml -f server/compose.local.yml logs -f postgres garage ollama",
    "infra:ollama:pull": "docker compose -p weave -f server/compose.dokploy.yml -f server/compose.local.yml --profile setup run --rm ollama-models",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:dev": "npm --prefix desktop run dev:signed",
    "desktop:dev:flare": "npm --prefix desktop run dev:flare",
    "desktop:dev:coppermind": "npm --prefix desktop run dev:coppermind",
    "desktop:perf": "npm --prefix desktop run perf",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:package:flare": "npm --prefix desktop run package:flare",
    "desktop:package:coppermind": "npm --prefix desktop run package:coppermind",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:test": "npm --prefix desktop run test",
    "portal:check": "deno task --config portal/deno.json check",
    "portal:test": "deno task --config portal/deno.json test",
