    "ollama:embeddings": "deno task ollama:embeddings:start",
    "ollama:embeddings:start": "deno run --allow-run=docker --allow-net=127.0.0.1,localhost --allow-env=WEAVE_OLLAMA_CONTAINER,WEAVE_OLLAMA_VOLUME,WEAVE_OLLAMA_PORT,WEAVE_OLLAMA_IMAGE,WEAVE_OLLAMA_MODEL,WEAVE_OLLAMA_PLATFORM scripts/ollama-embeddings.ts start",
    "ollama:embeddings:status": "deno run --allow-run=docker --allow-net=127.0.0.1,localhost --allow-env=WEAVE_OLLAMA_CONTAINER,WEAVE_OLLAMA_VOLUME,WEAVE_OLLAMA_PORT,WEAVE_OLLAMA_IMAGE,WEAVE_OLLAMA_MODEL,WEAVE_OLLAMA_PLATFORM scripts/ollama-embeddings.ts status",
    "ollama:embeddings:stop": "deno run --allow-run=docker --allow-env=WEAVE_OLLAMA_CONTAINER,WEAVE_OLLAMA_VOLUME,WEAVE_OLLAMA_PORT,WEAVE_OLLAMA_IMAGE,WEAVE_OLLAMA_MODEL,WEAVE_OLLAMA_PLATFORM scripts/ollama-embeddings.ts stop",
    "ollama:embeddings:logs": "deno run --allow-run=docker --allow-env=WEAVE_OLLAMA_CONTAINER,WEAVE_OLLAMA_VOLUME,WEAVE_OLLAMA_PORT,WEAVE_OLLAMA_IMAGE,WEAVE_OLLAMA_MODEL,WEAVE_OLLAMA_PLATFORM scripts/ollama-embeddings.ts logs",
    "grammar:seed": "node .agents/skills/lezer-grammar-harness/scripts/seed.mjs",
