{
  "name": "weave-desktop",
  "productName": "Weave",
  "version": "0.1.0",
  "private": true,
  "description": "Weave desktop client",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "node scripts/prepare-signed-electron-dev.mjs && ELECTRON_OVERRIDE_DIST_PATH=.electron-signed-dev electron-forge start",
    "perf": "WEAVE_PERF_LOG=1 WEAVE_PERF_DIR=../.weave-perf electron-forge start --inspect-electron --enable-logging",
    "prepackage": "deno task --config ../portal/deno.json build",
    "package": "node scripts/package.mjs",
    "package:signed": "WEAVE_DESKTOP_CODESIGN=1 pnpm package",
    "make": "electron-forge make",
    "make:signed": "WEAVE_DESKTOP_CODESIGN=1 pnpm make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:acceptance": "bun run package && WEAVE_FULL_STACK_ACCEPTANCE=1 vitest run tests/full-stack-acceptance.test.ts",
    "test:smoke": "WEAVE_ELECTRON_SMOKE=1 vitest run tests/electron-smoke.test.ts"
  },
  "dependencies": {
    "@weave/client": "workspace:*",
    "@weave/protocol": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@blocksuite/store": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/state": "catalog:",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@lezer/highlight": "catalog:",
    "@mastra/core": "catalog:",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "catalog:",
    "electron": "42.6.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.21.0"
  }
}
