{
  "name": "weave-desktop",
  "productName": "Weave",
  "version": "0.1.0",
  "private": true,
  "description": "Weave desktop client",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "dev:signed": "node scripts/prepare-signed-electron-dev.mjs && ELECTRON_OVERRIDE_DIST_PATH=.electron-signed-dev electron-forge start",
    "dev:flare": "npm run dev",
    "dev:coppermind": "npm run dev",
    "start": "electron-forge start",
    "perf": "WEAVE_PERF_LOG=1 WEAVE_PERF_DIR=../.weave-perf electron-forge start --inspect-electron --enable-logging",
    "prepackage": "npm run --prefix .. portal:build",
    "package": "node scripts/package.mjs",
    "package:signed": "WEAVE_DESKTOP_CODESIGN=1 npm run package",
    "package:flare": "npm run package",
    "package:coppermind": "npm run package",
    "make": "electron-forge make",
    "make:signed": "WEAVE_DESKTOP_CODESIGN=1 npm run make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "WEAVE_ELECTRON_SMOKE=1 vitest run tests/electron-smoke.test.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.53",
    "@assistant-ui/react": "^0.14.0",
    "@assistant-ui/react-ai-sdk": "^1.3.23",
    "@atomic-editor/editor": "^0.4.3",
    "@azurity/pure-nerd-font": "^3.0.5",
    "@base-ui/react": "^1.5.0",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@criblinc/docker-names": "^1.2.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-icons/material-symbols": "^1.2.58",
    "@iconify/react": "^6.0.2",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.170.9",
    "@toeverything/theme": "1.1.23",
    "@weave/client": "file:../packages/client",
    "@weave/protocol": "file:../packages/protocol",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.53",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.4.0",
    "yaml": "^2.9.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "@blocksuite/icons": "2.1.75"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@lezer/generator": "^1.8.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "42.3.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "ws": "^8.21.0"
  }
}
