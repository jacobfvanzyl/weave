+class InputTask final : public CefTask {
+public:
+  explicit InputTask(std::function<void()> fn) : fn_(std::move(fn)) {}
+  void Execute() override { fn_(); }
+private:
+  std::function<void()> fn_;
+  IMPLEMENT_REFCOUNTING(InputTask);
+};
+static void closeRuntime() {
+  if (!running) return;
+  running = false;
+  stop(0); // Wake the reader; never wait for stdin during shutdown.
+  auto current = pages;
+  for (auto &[_, page] : current)
+    if (page->browser) page->browser->GetHost()->CloseBrowser(true);
+  // Pending CreateBrowser calls close themselves in OnAfterCreated.
+  if (pages.empty()) CefQuitMessageLoop();
+}
+static void startInput() {
+  inputThread = std::thread([] {
+    std::string input;
+    bool done = false;
+    while (!done) {
+      pollfd descriptors[] = {{STDIN_FILENO, POLLIN, 0}, {wakePipe[0], POLLIN, 0}};
+      int status = poll(descriptors, 2, -1);
+      if (status < 0) { if (errno == EINTR) continue; break; }
+      if (descriptors[1].revents) break;
+      if (!descriptors[0].revents) continue;
+      char buffer[8192];
+      ssize_t n = read(STDIN_FILENO, buffer, sizeof(buffer));
+      if (n <= 0) { if (n < 0 && errno == EINTR) continue; break; }
+      input.append(buffer, n);
+      if (input.size() > 1048576) break;
+      size_t end;
+      while ((end = input.find('\n')) != std::string::npos) {
+        auto line = input.substr(0, end);
+        input.erase(0, end + 1);
+        size_t bytes = line.size();
+        if (queuedBytes.load() + bytes > 1048576 || queuedCommands.load() >= 1024) { done = true; break; }
+        queuedBytes.fetch_add(bytes); queuedCommands.fetch_add(1);
+        if (!CefPostTask(TID_UI, new InputTask([line = std::move(line), bytes] {
+              queuedBytes.fetch_sub(bytes); queuedCommands.fetch_sub(1);
+              if (running) command(line);
+            }))) { done = true; break; }
+      }
+    }
+    CefPostTask(TID_UI, new InputTask([] { closeRuntime(); }));
+  });
+}
