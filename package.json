{
  "name": "weave",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "product/alpha",
    "product/protocol",
    "product/portal"
  ],
  "scripts": {
    "preinstall": "bun scripts/ensure-bun.mjs",
    "check:boundary": "bun product/scripts/check-boundary.ts",
    "test:boundary": "bun test product/scripts/check-boundary.test.ts",
    "test:protocol": "bun test product/protocol/src",
    "test:alpha": "cd product/alpha && bun run test",
    "dev:alpha": "cd product/alpha && bun run dev",
    "build:alpha": "cd product/alpha && bun run build",
    "build:alpha:macos": "cd product/alpha && bun run build:macos",
    "run:alpha:macos": "cd product/alpha && bun run run:macos",
    "check:portal": "bun run --cwd product/portal check",
    "test:portal": "bun run --cwd product/portal test",
    "check": "bun run check:boundary && bun run test:boundary && bun run test:protocol && bun run test:alpha && bun run build:alpha && bun run check:portal && bun run test:portal",
    "dev:host": "bun run --cwd product/portal dev",
    "build:host": "bun run --cwd product/portal build"
  },
  "description": "Weave Alpha and Host Daemon"
}
