@top SourceFile { Item* }

Item {
  Annotation |
  Parenthesized |
  Bracketed |
  Block |
  Keyword |
  BuiltinType |
  Boolean |
  Null |
  String |
  Number |
  RecordField |
  TypeIdentifier |
  Identifier |
  Dot |
  Operator |
  Punctuation
}

Annotation { "@" (Identifier | TypeIdentifier) }

Parenthesized { "(" Item* ")" }

Bracketed { "[" Item* "]" }

Block { "{" Item* "}" }

Keyword {
  kw<"abstract"> | kw<"as"> | kw<"assert"> | kw<"async"> | kw<"await"> | kw<"base"> |
  kw<"break"> | kw<"case"> | kw<"catch"> | kw<"class"> | kw<"const"> | kw<"continue"> |
  kw<"covariant"> | kw<"default"> | kw<"deferred"> | kw<"do"> | kw<"else"> |
  kw<"enum"> | kw<"export"> | kw<"extends"> | kw<"extension"> | kw<"external"> |
  kw<"factory"> | kw<"final"> | kw<"finally"> | kw<"for"> | kw<"get"> | kw<"hide"> |
  kw<"if"> | kw<"implements"> | kw<"import"> | kw<"in"> | kw<"interface"> |
  kw<"is"> | kw<"late"> | kw<"library"> | kw<"mixin"> | kw<"new"> | kw<"on"> |
  kw<"operator"> | kw<"part"> | kw<"required"> | kw<"rethrow"> | kw<"return"> |
  kw<"sealed"> | kw<"set"> | kw<"show"> | kw<"static"> | kw<"super"> |
  kw<"switch"> | kw<"sync"> | kw<"this"> | kw<"throw"> | kw<"try"> | kw<"var"> |
  kw<"when"> | kw<"while"> | kw<"with"> | kw<"yield">
}

BuiltinType { @specialize[@name=BuiltinType]<identifier, "bool" | "double" | "int" | "num" | "dynamic" | "void"> }
Boolean { @specialize[@name=Boolean]<identifier, "true" | "false"> }
Null { @specialize[@name=Null]<identifier, "null"> }
TypeIdentifier { typeIdentifier }
Identifier { identifier }
kw<term> { @specialize[@name={term}]<identifier, term> }

@skip { whitespace | LineComment | DocLineComment | BlockComment | DocBlockComment }

@external tokens dartTokens from "./tokens" { String, BlockComment, DocBlockComment }

@tokens {
  whitespace { $[ \t\n\r]+ }

  LineComment { "//" ![\n]* }
  DocLineComment { "///" ![\n]* }

  Number {
    "0x" $[0-9a-fA-F_]+ |
    $[0-9] $[0-9_]* ("." $[0-9_]+)? (($[eE] $[+\-]? $[0-9_]+))?
  }

  RecordField { "$" $[0-9]+ }

  typeIdentifier { $[A-Z] $[A-Za-z0-9_]* }
  identifier { $[a-z_] $[A-Za-z0-9_]* }

  Dot { "." }

  Operator {
    "=>" | "..." | "..?" | ".." | "?." | "??=" | "??" | "==" | "!=" | ">=" | "<=" |
    "&&" | "||" | "++" | "--" | "+=" | "-=" | "*=" | "/=" | "~/=" | "%=" | "&=" |
    "|=" | "^=" | "<<=" | ">>=" | ">>>=" | "<<" | ">>>" | ">>" | "~" | "!" | "=" |
    "+" | "-" | "*" | "/" | "%" | "&" | "|" | "^" | "<" | ">"
  }

  Punctuation { ";" | ":" | "," | "?" }

  @precedence { DocLineComment, LineComment, Operator }
  @precedence { Operator, Dot, Punctuation }
}
