    "@tailwindcss/vite": "^4.3.3",
    "@weave/product-protocol": "workspace:*",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.0",
    "streamdown": "^2.6.0",
