    "acceptance:browser:apple-control:test": "bun test acceptance/apple-browser-control-source.test.ts",
    "acceptance:browser:control:evidence:test": "bun test acceptance/browser-control/journal-evidence.test.ts",
    "acceptance:browser:control:evidence": "bun acceptance/browser-control/journal-evidence.ts",
    "acceptance:browser:macos": "bun acceptance/macos-host/run-macos-cli.ts",
    "acceptance:browser:macos:test": "bun test acceptance/macos-host/run-macos.test.ts",
    "acceptance:browser:ipad": "bun acceptance/ipad-host/run-ipad.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "cap:sync": "bun run build && cap sync",
    "ios:add": "cap add ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
