{
  "name": "@weave/alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun run vite --host 0.0.0.0 --port 5174",
    "test": "bun --bun run vitest run",
    "build": "bun --bun run tsc -b && bun --bun run vite build",
    "preview": "bun --bun run vite preview --host 0.0.0.0 --port 4174",
    "cap:sync": "bun run build && bun --bun run cap sync ios",
    "ios:add": "bun --bun run cap add ios",
    "ios:open": "bun --bun run cap open ios",
    "check:desktop": "bun --bun run tsc -p electron/tsconfig.json && bun --bun run tsc -p tsconfig.tools.json",
    "build:desktop": "bun scripts/build-desktop.ts",
    "dev:desktop": "bun scripts/build-desktop.ts --dev",
    "run:desktop": "bun scripts/run-desktop.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@base-ui/react": "^1.7.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.3.4",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/status-bar": "^8.0.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@weave/product-protocol": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^4.12.3",
    "shadcn": "^4.19.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.1.11",
    "electron": "44.3.0",
    "@electron/packager": "20.3.0",
    "@types/bun": "1.3.14"
  }
}
