{
  "name": "@weave/alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "build:macos": "bun scripts/build-macos.ts",
    "run:macos": "open 'dist/Weave Alpha.app'",
    "acceptance:browser:fixture": "bun acceptance/browser-fixture/server.ts",
