{
  "name": "@weave/host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/main.ts serve --config portal.config.json",
    "check": "bun --bun run tsc --noEmit",
    "test": "bun test ./src",
    "build": "bun scripts/build.ts",
    "acceptance": "bun scripts/acceptance.ts",
    "acceptance:filesystem": "bun scripts/filesystem-acceptance.ts",
    "acceptance:terminal": "bun scripts/terminal-acceptance.ts",
    "sign:macos": "bun scripts/sign-macos.ts",
    "build:linux": "bun scripts/build.ts --linux",
    "build:macos-signed": "bun run build && bun run sign:macos"
  },
  "dependencies": {
    "@weave/product-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  }
}
