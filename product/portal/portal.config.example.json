{
  "listen": { "hostname": "0.0.0.0", "port": 4122 },
  "displayName": "My Mac",
  "tls": {
    "certificateFile": "/absolute/path/to/my-mac.example.ts.net.crt",
    "privateKeyFile": "/absolute/path/to/my-mac.example.ts.net.key"
  },
  "allowedOrigins": ["http://localhost:5174", "capacitor://localhost", "weave://app"],
  "stateDirectory": "/absolute/path/to/portal-state",
  "threadEventRetentionLimit": 10000,
  "executionContexts": [
    { "executionContextId": "workspace", "name": "Workspace", "path": "/absolute/path/to/workspace" }
  ],
  "agents": [
    { "agentId": "codex", "name": "Codex", "command": "codex-acp", "args": [] }
  ]
}
