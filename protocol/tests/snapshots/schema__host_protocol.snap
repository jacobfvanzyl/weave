          "type": [
            "string",
            "null"
          ],
          "description": "This turn rather than the latest, a queued one included; it fails with `unknown_turn`\nwhen the thread's journal has no such turn (feature `turnIds`)."
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`threads/get`: one thread the Host has a journal for, open or not, as `threads/list` lists\nit, with its latest turn, or the turn asked for, read without opening it or attaching."
    },
