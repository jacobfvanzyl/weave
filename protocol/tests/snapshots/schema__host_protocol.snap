        },
        "trace": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the Host writes this session's protocol trace, when asked to."
        },
        "update": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentUpdate"
            },
            {
              "type": "null"
            }
          ],
          "description": "A newer version of the agent than the session runs, once the Host has found one."
        },
        "startedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The session whose agent started it, for a delegated session."
        }
      },
      "required": [
        "sessionId",
        "agent",
        "cwd",
        "state",
        "activity",
        "clients",
        "blank",
        "policy",
        "journal"
      ],
      "description": "An open session as a client attached to it sees it; notifications keep it up to date."
    },
