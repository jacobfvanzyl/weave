    "CreateWorktreeRequest": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Any directory in the repository."
        },
        "branch": {
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "description": "What a new branch starts from: a branch, tag or commit. The default branch when absent,\nelse the primary worktree's HEAD. Refused for a branch that exists."
        }
      },
      "required": [
        "repo",
        "branch"
      ],
      "description": "`worktrees/create`: a new worktree for `branch`, beside the repository as\n`<repo>.<branch>` with the branch made safe for a path (`feature/auth` becomes\n`weave.feature-auth`). A branch that doesn't exist is made from `base`. One that exists is\nchecked out, a branch only a remote has included, unless another worktree has it checked\nout. The client then starts a thread there with `thread/create`."
    },
    "CreateWorktreeResponse": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The new worktree."
        },
        "branch": {
          "type": "string"
        },
        "createdBranch": {
          "type": "boolean",
          "description": "The branch was made for it, rather than one that existed."
        }
      },
      "required": [
        "path",
        "branch"
      ]
    },
    "RemoveWorktreeRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "force": {
          "type": "boolean",
          "description": "Remove it with its changes, which are lost."
        },
        "deleteBranch": {
          "type": "boolean",
          "description": "Delete its branch even when it isn't merged, losing commits only it has."
        }
      },
      "required": [
        "path"
      ],
      "description": "`worktrees/remove`: remove a worktree other than the primary one. Refused while a thread\nin it runs a turn or waits on a request (`worktree_busy`), and when it has changes\n(`uncommitted_changes`) unless `force`. Otherwise the threads open in it close first. Their\njournals stay, so they can still be deleted. Its branch is deleted when git counts it merged,\nand regardless with `deleteBranch`."
    },
    "RemoveWorktreeResponse": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "The threads that were open in it, now closed.",
          "default": []
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its branch; absent when its HEAD was detached."
        },
        "branchDeleted": {
          "type": "boolean"
        }
      }
    },
    "ReleaseWorktreeRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "description": "`worktrees/release`: let a worktree go before something else removes it, as\n`weave worktrees pre-remove` asks when worktrunk does. Refused, as `worktrees/remove` is,\nwhile a thread in it runs a turn or waits on a request; otherwise the threads open in it\nclose."
    },
    "ReleaseWorktreeResponse": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "The threads that were open in it, now closed.",
          "default": []
        }
      }
    },
    "InitRepositoryRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute on the Host's computer, or under its user's home as `~/…`."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositoryFile"
          },
          "description": "Relative to the directory, within it: no `..`, no `.git`, each once."
        },
        "message": {
          "type": "string",
          "description": "The commit message for `files`, which needs one."
        }
      },
      "required": [
        "path"
      ],
      "description": "`repos/init`: a directory on the Host's computer that is a git repository of its own, with\n`files` written and committed in it. The directory, and its parents, are made if they aren't\nthere, and `git init` makes it a repository unless it's the top of one already; one inside\nanother repository's work tree is refused, as a repository of its own is asked for. If any\nof `files` is there already, as a file, a directory or a link, none is written and nothing is\ncommitted. Otherwise each is written, never over anything, and those files alone are\ncommitted with `message`, as the user git's configuration names; without a `user.name` and\n`user.email` there, they're left written but uncommitted, and the answer says so. Nothing\nelse in the directory is touched or committed."
    },
    "RepositoryFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "text"
      ],
      "description": "A file [`InitRepositoryRequest`] writes, as UTF-8 text."
    },
    "InitRepositoryResponse": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The directory, absolute, with symlinks resolved."
        },
        "created": {
          "type": "boolean",
          "description": "It wasn't there, and was made."
        },
        "initialized": {
          "type": "boolean",
          "description": "It wasn't the top of a repository, and is one now."
        },
        "files": {
          "anyOf": [
            {
              "$ref": "#/$defs/FilesMade"
            },
            {
              "type": "null"
            }
          ],
          "description": "What became of the files; absent when none were named."
        }
      },
      "required": [
        "path"
      ]
    },
    "FilesMade": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "file": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "kept"
            }
          },
          "required": [
            "state",
            "file"
          ],
          "description": "This one of them was there already, so none was written."
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "committed"
            }
          },
          "required": [
            "state"
          ],
          "description": "Written, and committed on their own."
        },
        {
          "type": "object",
          "properties": {
            "why": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "uncommitted"
            }
          },
          "required": [
            "state",
            "why"
          ],
          "description": "Written, but not committed, for this reason."
        }
      ],
      "description": "What became of the files [`InitRepositoryRequest`] named."
    },
