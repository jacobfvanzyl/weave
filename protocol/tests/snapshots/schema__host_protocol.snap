    "CreateWorktreeRequest": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "Any directory in the repository."
        },
        "branch": {
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "description": "What a new branch starts from: a branch, tag or commit. The default branch when absent,\nelse the primary worktree's HEAD. Refused for a branch that exists."
        }
      },
      "required": [
        "repo",
        "branch"
      ],
      "description": "`worktrees/create`: a new worktree for `branch`, beside the repository as\n`<repo>.<branch>` with the branch made safe for a path (`feature/auth` becomes\n`weave.feature-auth`). A branch that doesn't exist is made from `base`. One that exists is\nchecked out, a branch only a remote has included, unless another worktree has it checked\nout. The client then starts a session there with `session/create`."
    },
    "CreateWorktreeResponse": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The new worktree."
        },
        "branch": {
          "type": "string"
        },
        "createdBranch": {
          "type": "boolean",
          "description": "The branch was made for it, rather than one that existed."
        }
      },
      "required": [
        "path",
        "branch"
      ]
    },
    "RemoveWorktreeRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "force": {
          "type": "boolean",
          "description": "Remove it with its changes, which are lost."
        },
        "deleteBranch": {
          "type": "boolean",
          "description": "Delete its branch even when it isn't merged, losing commits only it has."
        }
      },
      "required": [
        "path"
      ],
      "description": "`worktrees/remove`: remove a worktree other than the primary one. Refused while a session\nin it runs a turn or waits on a request (`worktree_busy`), and when it has changes\n(`uncommitted_changes`) unless `force`. Otherwise the sessions open in it close first. Their\njournals stay, so they can still be deleted. Its branch is deleted when git counts it merged,\nand regardless with `deleteBranch`."
    },
    "RemoveWorktreeResponse": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "The sessions that were open in it, now closed.",
          "default": []
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its branch; absent when its HEAD was detached."
        },
        "branchDeleted": {
          "type": "boolean"
        }
      }
    },
    "ReleaseWorktreeRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "description": "`worktrees/release`: let a worktree go before something else removes it, as\n`weave worktrees pre-remove` asks when worktrunk does. Refused, as `worktrees/remove` is,\nwhile a session in it runs a turn or waits on a request; otherwise the sessions open in it\nclose."
    },
    "ReleaseWorktreeResponse": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "The sessions that were open in it, now closed.",
          "default": []
        }
      }
    },
    "SessionEventNotification": {
      "type": "object",
