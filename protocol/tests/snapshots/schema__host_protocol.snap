    "ListFilesRequest": {
      "type": "object",
      "properties": {
        "path": {
          "type": [
            "string",
            "null"
          ],
          "description": "An absolute path; the home directory of the Host's user when absent."
        },
        "hidden": {
          "type": "boolean",
          "description": "Entries whose names start with a dot too."
        }
      },
      "description": "`files/list`: what a directory on the Host's computer holds, by name and kind."
    },
    "ListFilesResponse": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The directory listed, without `.` or `..`. Symlinks stay as named, so a session's\ndirectory reads as the person chose it."
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its parent; none at the root."
        },
        "home": {
          "type": "string",
          "description": "The home directory of the Host's user, so clients can show paths under it as `~`."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          },
          "description": "Directories first, then by name. Names that aren't UTF-8 are left out."
        },
        "truncated": {
          "type": "boolean",
          "description": "The directory holds more than [`MAX_ENTRIES`] entries the request asked for."
        }
      },
      "required": [
        "path",
        "home",
        "entries"
      ]
    },
    "FileEntry": {
      "type": "object",
