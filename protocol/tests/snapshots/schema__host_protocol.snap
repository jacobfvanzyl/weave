---
source: protocol/tests/schema.rs
expression: schema()
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostProtocolSchema",
  "description": "The weave Host protocol (docs/specs/wve-85-host-protocol.md), generated from protocol/.",
  "type": "object",
  "x-weave-requests": {
    "host/hello": {
      "params": "HelloRequest",
      "result": "HelloResponse"
    },
    "host/challenge": {
      "params": "ChallengeRequest",
      "result": "ChallengeResponse"
    },
    "host/status": {
      "params": "StatusRequest",
      "result": "HostStatus"
    },
    "host/drain": {
      "params": "DrainRequest",
      "result": "DrainResponse"
    },
    "host/shutdown": {
      "params": "ShutdownRequest",
      "result": "Empty"
    },
    "agents/list": {
      "params": "ListAgentsRequest",
      "result": "ListAgentsResponse"
    },
    "agents/get": {
      "params": "GetAgentRequest",
      "result": "GetAgentResponse"
    },
    "agents/authenticate": {
      "params": "AuthenticateAgentRequest",
      "result": "Empty"
    },
    "agents/terminalSignIn": {
      "params": "TerminalSignInRequest",
      "result": "TerminalSignInResponse"
    },
    "agents/logout": {
      "params": "LogoutAgentRequest",
      "result": "Empty"
    },
    "agents/update": {
      "params": "UpdateAgentRequest",
      "result": "UpdateAgentResponse"
    },
    "devices/offer": {
      "params": "OfferDeviceRequest",
      "result": "OfferDeviceResponse"
    },
    "devices/list": {
      "params": "ListDevicesRequest",
      "result": "ListDevicesResponse"
    },
    "devices/revoke": {
      "params": "RevokeDeviceRequest",
      "result": "Empty"
    },
    "files/list": {
      "params": "ListFilesRequest",
      "result": "ListFilesResponse"
    },
    "sessions/list": {
      "params": "ListSessionsRequest",
      "result": "ListSessionsResponse"
    },
    "sessions/get": {
      "params": "GetSessionRequest",
      "result": "GetSessionResponse"
    },
    "sessions/watch": {
      "params": "WatchSessionsRequest",
      "result": "WatchSessionsResponse"
    },
    "sessions/unwatch": {
      "params": "UnwatchSessionsRequest",
      "result": "Empty"
    },
    "session/create": {
      "params": "CreateSessionRequest",
      "result": "SessionState"
    },
    "session/attach": {
      "params": "AttachSessionRequest",
      "result": "AttachSessionResponse"
    },
    "session/detach": {
      "params": "DetachSessionRequest",
      "result": "Empty"
    },
    "session/close": {
      "params": "CloseSessionRequest",
      "result": "Empty"
    },
    "session/delete": {
      "params": "DeleteSessionRequest",
      "result": "Empty"
    },
    "session/setMode": {
      "params": "SetModeRequest",
      "result": "Empty"
    },
    "session/setConfigOption": {
      "params": "SetConfigOptionRequest",
      "result": "SetSessionConfigOptionResponse"
    },
    "session/reopen": {
      "params": "ReopenSessionRequest",
      "result": "ReopenSessionResponse"
    },
    "session/rename": {
      "params": "RenameSessionRequest",
      "result": "Empty"
    },
    "session/run": {
      "params": "RunRequest",
      "result": "RunResponse"
    },
    "turn/start": {
      "params": "StartTurnRequest",
      "result": "StartTurnResponse"
    },
    "turn/steer": {
      "params": "SteerTurnRequest",
      "result": "SteerTurnResponse"
    },
    "turn/cancel": {
      "params": "CancelTurnRequest",
      "result": "Empty"
    },
    "queue/add": {
      "params": "AddQueuedRequest",
      "result": "AddQueuedResponse"
    },
    "queue/remove": {
      "params": "RemoveQueuedRequest",
      "result": "RemoveQueuedResponse"
    },
    "queue/resume": {
      "params": "ResumeQueueRequest",
      "result": "Empty"
    },
    "pending/answer": {
      "params": "AnswerPendingRequest",
      "result": "Empty"
    },
    "worktrees/list": {
      "params": "ListWorktreesRequest",
      "result": "ListWorktreesResponse"
    },
    "worktrees/create": {
      "params": "CreateWorktreeRequest",
      "result": "CreateWorktreeResponse"
    },
    "worktrees/remove": {
      "params": "RemoveWorktreeRequest",
      "result": "RemoveWorktreeResponse"
    },
    "worktrees/release": {
      "params": "ReleaseWorktreeRequest",
      "result": "ReleaseWorktreeResponse"
    }
  },
  "x-weave-notifications": {
    "session/event": "SessionEventNotification",
    "session/changed": "SessionChangedNotification",
    "sessions/updated": "SessionUpdatedNotification",
    "sessions/removed": "SessionRemovedNotification",
    "session/elicitationCompleted": "ElicitationCompletedNotification",
    "pending/added": "PendingAddedNotification",
    "pending/resolved": "PendingResolvedNotification",
    "agents/updateAvailable": "UpdateAvailableNotification",
    "devices/paired": "DevicePairedNotification"
  },
  "x-weave-constants": {
    "protocol": {
      "version": 2,
      "oldestSupported": 2
    },
    "websocket": {
      "subprotocol": "weave-host",
      "appOrigin": "capacitor://localhost",
      "maxMessage": 33554432,
      "closeRevoked": 4000,
      "closeBehind": 4001,
      "closeUnauthenticated": 4002
    },
    "errors": {
      "unauthenticated": -32060,
      "incompatibleProtocol": -32061,
      "unknownAgent": -32062,
      "unknownSession": -32063,
      "sessionNotOpen": -32064,
      "turnRunning": -32065,
      "alreadyResolved": -32066,
      "wrongAgent": -32067,
      "requiresTerminal": -32068,
      "forbidden": -32069,
      "notTarget": -32070,
      "remoteUnavailable": -32071,
      "worktreeBusy": -32072,
      "notARepository": -32073,
      "gitFailed": -32074,
      "uncommittedChanges": -32075,
      "keyReused": -32076,
      "hostStopping": -32077
    },
    "features": {
      "steer": "turn/steer",
      "devices": "devices",
      "agentUpdates": "agents/updates",
      "clientTools": "clientTools",
      "watch": "sessions/watch",
      "listFiles": "files/list",
      "rename": "session/rename",
      "worktrees": "worktrees",
      "queue": "queue",
      "getSession": "sessions/get",
      "requestKeys": "requestKeys",
      "drain": "drain"
    },
    "files": {
      "maxEntries": 2000
    },
    "sessions": {
      "maxTitle": 200
    },
    "requestKeys": {
      "maxKey": 200
    },
    "clientTools": {
      "clipboardWrite": "clipboard_write"
    },
    "hostTools": {
      "renameSession": "rename_session",
      "listSessions": "list_sessions",
      "readSession": "read_session",
      "startSession": "start_session",
      "promptSession": "prompt_session",
      "steerSession": "steer_session",
      "cancelSessionTurn": "cancel_session_turn"
    }
  },
  "$defs": {
    "HelloRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/VersionRange",
          "description": "The major versions the client speaks."
        },
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "auth": {
          "$ref": "#/$defs/Auth"
        },
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities",
          "default": {
            "terminalSignIn": false
          }
        }
      },
      "required": [
        "protocol",
        "client",
        "auth"
      ]
    },
    "VersionRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "description": "A range of major versions, both ends included."
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "What the client is, such as `weave-tui`."
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "local"
            }
          },
          "required": [
            "method"
          ],
          "description": "The socket's peer is the Host's own user. Only on the Unix socket and in-process."
        },
        {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "const": "token"
            }
          },
          "required": [
            "method",
            "token"
          ],
          "description": "Reserved, and refused everywhere; the next major version removes it."
        },
        {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string"
            },
            "signature": {
              "type": "string",
              "description": "The DER-encoded ECDSA P-256 SHA-256 signature, in unpadded base64url."
            },
            "method": {
              "type": "string",
              "const": "device"
            }
          },
          "required": [
            "method",
            "deviceId",
            "signature"
          ],
          "description": "A paired device, on the WebSocket: its signature of the connection's challenge\n([`ChallengeRequest`]), as [`crate::devices::auth_message`] spells it."
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "device": {
              "$ref": "#/$defs/NewDevice"
            },
            "method": {
              "type": "string",
              "const": "pair"
            }
          },
          "required": [
            "method",
            "code",
            "device"
          ],
          "description": "A device pairing, on the WebSocket, with the code `weave pair` showed. The\nconnection is that device's from then on."
        }
      ],
      "description": "How a connection authenticates."
    },
    "NewDevice": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "What the person calls it, such as \"Jaco's iPad\". An offer made with a name uses that\ninstead."
        },
        "publicKey": {
          "$ref": "#/$defs/Jwk"
        }
      },
      "required": [
        "name",
        "publicKey"
      ],
      "description": "A device pairing, as it introduces itself."
    },
    "Jwk": {
      "type": "object",
      "properties": {
        "kty": {
          "type": "string",
          "description": "`EC`."
        },
        "crv": {
          "type": "string",
          "description": "`P-256`."
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "description": "A P-256 public key as a JWK: `x` and `y` are its coordinates, 32 bytes each, in unpadded\nbase64url."
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "terminalSignIn": {
          "type": "boolean",
          "description": "The client can run an agent's sign-in command in a terminal on the Host's computer.\nOnly local clients may say so.",
          "default": false
        },
        "clientTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The client tools ([`crate::tools`]) this client runs on its device."
        }
      }
    },
    "HelloResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "The version this connection speaks: the highest both ends do."
        },
        "clientId": {
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional parts of the protocol this Host supports.",
          "default": []
        },
        "acp": {
          "$ref": "#/$defs/AcpInfo"
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The paired device a remote client connected as; none for a local client."
        }
      },
      "required": [
        "protocol",
        "clientId",
        "host",
        "acp"
      ]
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The Host's own id, which stays the same across restarts, so clients tell Hosts apart.",
          "default": ""
        },
        "version": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "pid",
        "startedAt"
      ]
    },
    "AcpInfo": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The ACP protocol version the Host speaks to agents."
        },
        "unstable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unstable ACP features the Host may pass through, such as `subagents`.",
          "default": []
        }
      },
      "required": [
        "protocolVersion"
      ],
      "description": "Which ACP payloads to expect."
    },
    "DeviceInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "description": "Which device a connection is."
    },
    "ChallengeRequest": {
      "type": "object",
      "description": "`host/challenge`: what a paired device signs in its `host/hello`. Only on the WebSocket,\nbefore hello."
    },
    "ChallengeResponse": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "description": "The Host's id, which the device checks is the Host it paired with."
        },
        "nonce": {
          "type": "string",
          "description": "32 random bytes, in unpadded base64url, good for one hello on this connection."
        },
        "expiresAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "hostId",
        "nonce",
        "expiresAt"
      ]
    },
    "StatusRequest": {
      "type": "object",
      "description": "`host/status`."
    },
    "HostStatus": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "service": {
          "$ref": "#/$defs/Service"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSource"
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionListing"
          },
          "description": "The open sessions."
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "The loopback address of the WebSocket remote clients reach, when the Host serves one."
        }
      },
      "required": [
        "protocol",
        "version",
        "pid",
        "startedAt",
        "service",
        "environment",
        "sessions"
      ]
    },
    "Service": {
      "oneOf": [
        {
          "type": "string",
          "const": "launchd",
          "description": "As a launchd user agent, with no idle exit."
        },
        {
          "type": "string",
          "const": "systemd",
          "description": "As a systemd user service, with no idle exit."
        },
        {
          "type": "string",
          "const": "onDemand",
          "description": "Started by a client, exiting once idle."
        },
        {
          "type": "string",
          "const": "inProcess",
          "description": "Inside a client (`--no-daemon`)."
        }
      ],
      "description": "How the Host runs."
    },
    "EnvironmentSource": {
      "oneOf": [
        {
          "type": "string",
          "const": "loginShell",
          "description": "The user's login shell, over the Host's own."
        },
        {
          "type": "string",
          "const": "process",
          "description": "The Host's own only: capturing the login shell's failed."
        }
      ],
      "description": "Where agents' environment comes from."
    },
    "SessionListing": {
      "type": "object",
      "properties": {
        "info": {
          "$ref": "#/$defs/SessionInfo",
          "description": "As ACP lists it: id, directory, title, last update."
        },
        "agentId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SessionStatus"
        },
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Activity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Open sessions only."
        },
        "clients": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "headless": {
          "type": "boolean",
          "description": "A permission policy answers its requests, so it runs with nobody attached.",
          "default": false
        },
        "lastActivityAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where in a git repository its directory is, as the Host last read it while the session\nwas open; absent outside one, and for sessions the Host has no record of."
        },
        "startedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The session whose agent started it, for a delegated session."
        }
      },
      "required": [
        "info",
        "agentId",
        "state"
      ]
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/SessionId",
          "description": "Unique identifier for the session"
        },
        "cwd": {
          "type": "string",
          "description": "The working directory for this session. Must be an absolute path."
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional workspace roots reported for this session. Each path must be absolute.\n\nWhen present, this is the complete ordered additional-root list reported\nby the Agent. Omitted and empty values are equivalent: the response\nreports no additional roots.",
          "x-deserialize-default-on-error": true,
          "x-deserialize-skip-invalid-items": true
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title for the session",
          "x-deserialize-default-on-error": true
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 timestamp of last activity",
          "x-deserialize-default-on-error": true
        },
        "_meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The _meta property is reserved by ACP to allow clients and agents to attach additional\nmetadata to their interactions. Implementations MUST NOT make assumptions about values at\nthese keys.\n\nSee protocol docs: [Extensibility](https://agentclientprotocol.com/protocol/extensibility)",
          "x-deserialize-default-on-error": true
        }
      },
      "required": [
        "sessionId",
        "cwd"
      ],
      "description": "Information about a session returned by session/list"
    },
    "SessionId": {
      "type": "string",
      "description": "A unique identifier for a conversation session between a client and agent.\n\nSessions maintain their own context, conversation history, and state,\nallowing multiple independent interactions with the same agent.\n\nSee protocol docs: [Session ID](https://agentclientprotocol.com/protocol/session-setup#session-id)"
    },
    "SessionStatus": {
      "oneOf": [
        {
          "type": "string",
          "const": "open",
          "description": "The Host holds it and its agent runs."
        },
        {
          "type": "string",
          "const": "suspended",
          "description": "It was open when its Host stopped; attaching opens it again from its journal."
        },
        {
          "type": "string",
          "const": "closed",
          "description": "The Host no longer holds it; attaching opens it again from the agent's history."
        }
      ]
    },
    "Activity": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "idle",
            "running"
          ]
        },
        {
          "type": "string",
          "const": "waiting",
          "description": "A pending request waits for a person."
        }
      ],
      "description": "What an open session is doing."
    },
    "GitLocation": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The repository, by its primary worktree."
        },
        "worktree": {
          "type": "string",
          "description": "The worktree the directory is in: the primary one or another."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "The branch checked out there; absent when its HEAD is detached."
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "The repository's remote as a host and path, such as `github.com/owner/name`, without\ncredentials or `.git`: `origin`, or else the first. Absent without one, or for a remote\nthat's a path on this computer."
        }
      },
      "required": [
        "repo",
        "worktree"
      ],
      "description": "Where in a git repository a session's directory is, as the Host last read it: when the\nsession opened, and again after each of its turns."
    },
    "DrainRequest": {
      "type": "object",
      "properties": {
        "wait": {
          "type": "boolean",
          "description": "Wait for running turns before answering.",
          "default": false
        },
        "except": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent process whose turn isn't waited for, from the `WEAVE_AGENT_PROCESS` the\nHost gives each agent: the one asking, when an agent stops the Host."
        }
      },
      "description": "`host/drain`: get ready to stop. From now on the Host starts no new turns (`turn/start`\nand `session/run` answer `host_stopping`, and queued prompts wait), and with `wait` it\nanswers once no turn runs but `except`'s, or when its drain timeout passes. The stop that\nfollows doesn't wait again. If the asking client goes before the Host stops, the drain\nends. Local clients only."
    },
    "DrainResponse": {
      "type": "object",
      "properties": {
        "running": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Turns still running, but for `except`'s, which stopping cuts off."
        }
      },
      "required": [
        "running"
      ]
    },
    "ShutdownRequest": {
      "type": "object",
      "description": "`host/shutdown`: suspend every open session and exit."
