        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "default": []
        },
        "subagents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "Subagent sessions so far.",
          "default": []
        },
