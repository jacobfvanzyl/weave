          "description": "Anything else: a socket, a device, or a symlink that leads nowhere."
        }
      ],
      "description": "What an entry is, following symlinks."
    },
    "ListThreadsRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "type": [
            "string",
            "null"
          ],
          "description": "Only the threads in this repository's worktrees, given by any directory in it. Without\nan agent only (feature `worktrees`)."
