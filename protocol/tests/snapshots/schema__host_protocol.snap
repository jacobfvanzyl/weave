          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "journal",
        "seq"
      ],
      "description": "An event's place in a thread's journal: where a client catches up after."
    },
    "AttachThreadResponse": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "agent": {
          "$ref": "#/$defs/ThreadAgent"
        },
        "cwd": {
          "type": "string"
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where in a git repository `cwd` is; absent outside one."
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "activity": {
          "$ref": "#/$defs/Activity"
        },
        "clients": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Attached now, the receiving client included."
        },
        "blank": {
          "type": "boolean",
          "description": "Nobody has prompted it yet."
        },
        "policy": {
          "$ref": "#/$defs/PermissionPolicy"
        },
        "modes": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionModeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "configOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionConfigOption"
          },
          "default": []
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RunningTurn"
          },
          "default": []
        },
        "queue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueuedPrompt"
          },
          "description": "Prompts waiting, in order, for the next turns (feature `queue`)."
        },
        "queuePaused": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueuePause"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the queue waits rather than start the next turn; absent while it runs."
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PendingRequest"
          },
          "default": []
        },
        "subagents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "Subagent threads so far.",
          "default": []
        },
        "journal": {
          "$ref": "#/$defs/JournalHead"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Things worth telling the user, such as skipped MCP servers.",
          "default": []
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/McpServerStatus"
          },
          "description": "The MCP servers its agent was given, or left without (feature [`crate::mcp::FEATURE`])."
        },
        "trace": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the Host writes this thread's protocol trace, when asked to."
        },
        "update": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentUpdate"
            },
            {
              "type": "null"
            }
          ],
          "description": "A newer version of the agent than the thread runs, once the Host has found one."
        },
        "startedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The thread whose agent started it, for a delegated thread."
        },
        "startedByHost": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Host the thread that started it is on, when it isn't this one."
        },
        "continuedIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its successor, as its listing's `continuedIn` (WVE-168)."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its labels, as its listing's (WVE-173)."
        },
        "replay": {
          "$ref": "#/$defs/Replay"
        }
      },
      "required": [
        "threadId",
        "agent",
        "cwd",
        "state",
        "activity",
        "clients",
        "blank",
        "policy",
        "journal",
        "replay"
      ],
      "description": "An open thread as a client attached to it sees it; notifications keep it up to date."
    },
    "Replay": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The first position sent."
        },
        "reset": {
          "type": "boolean",
          "description": "The journal isn't the one the client asked after: clear the transcript first."
        }
      },
      "required": [
        "from",
        "reset"
      ],
      "description": "The events that follow an attach response before live ones."
    },
    "DetachThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "close": {
          "$ref": "#/$defs/CloseWhen",
          "default": "never"
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`thread/detach`: stop receiving the thread."
    },
    "CloseWhen": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "never"
          ]
        },
        {
          "type": "string",
          "const": "ifUnused",
          "description": "Now, if nothing else needs it."
        }
      ],
      "description": "When detaching closes the thread."
    },
    "CloseThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`thread/close`: close the thread for everyone, ending its turn and stopping its agent."
    },
    "DeleteThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Required when the Host has no record of the thread."
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`thread/delete`: close it if open, delete it in the agent, and remove its journal."
    },
    "SetModeRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "modeId": {
          "$ref": "#/$defs/SessionModeId"
        }
      },
      "required": [
        "threadId",
        "modeId"
      ],
      "description": "`thread/setMode`. The change reaches every attached client as an ACP update."
    },
    "SetConfigOptionRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "configId": {
          "$ref": "#/$defs/SessionConfigId"
        }
      },
      "required": [
        "threadId",
        "configId"
      ],
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean",
              "description": "The boolean value."
            },
            "type": {
              "type": "string",
              "const": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "description": "A boolean value (`type: \"boolean\"`)."
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/SessionConfigValueId",
              "description": "The value ID."
            }
          },
          "required": [
            "value"
          ],
          "description": "A `SessionConfigValueId` string value.\n\nThis is the default when `type` is absent on the wire. Unknown `type`\nvalues with string payloads also gracefully deserialize into this\nvariant."
        }
      ],
      "description": "`thread/setConfigOption`. The change reaches every attached client as an ACP update."
    },
    "SetSessionConfigOptionResponse": {
      "type": "object",
      "properties": {
        "configOptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionConfigOption"
          },
          "description": "The full set of configuration options and their current values.",
          "x-deserialize-default-on-error": true,
          "x-deserialize-skip-invalid-items": true
        },
        "_meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The _meta property is reserved by ACP to allow clients and agents to attach additional\nmetadata to their interactions. Implementations MUST NOT make assumptions about values at\nthese keys.\n\nSee protocol docs: [Extensibility](https://agentclientprotocol.com/protocol/v1/extensibility)",
          "x-deserialize-default-on-error": true
        }
      },
      "required": [
        "configOptions"
      ],
      "description": "Response to `session/set_config_option` method.",
      "x-side": "agent",
      "x-method": "session/set_config_option"
    },
    "ReopenThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`thread/reopen`: stop the thread's agent and take the thread up again in a new process\nof the version the agent's new threads get, through ACP `session/resume` or\n`session/load`. The thread keeps its id and journal, where an `agentReopened` event marks\nthe change. While a turn runs or a request waits, it waits for them. When the new version\ncan't take the thread up, the old one does again, and the event says why. Anything that\nlived only in the old process, such as its background commands, ends with it."
    },
    "ReopenThreadResponse": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "The version the thread's agent runs now."
        }
      }
    },
    "RenameThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "title"
      ],
      "description": "`thread/rename`: give an open thread a title of the Host's, which its clients see, journaled\nas a `renamed` event, and which titles the agent sends later don't replace. The title is\ntrimmed, and must be 1 to [`MAX_TITLE`] characters. The agent's own record of the thread\nkeeps its title: ACP has no way to change it from outside."
    },
    "SetSuccessorRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "successor": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "threadId",
        "successor"
      ],
      "description": "`thread/setSuccessor`: name the thread an open thread's work goes on in, as the\nDispatcher does when it starts a Bot's new thread. Journaled as a `continuedIn` event and\nlisted as the thread's `continuedIn`; reports to the thread go to its successor from then\non. The successor is a thread the Host has a record of, other than this one and not one\nwhose successors lead back to it. A thread's successor is named once: naming the same one\nagain does nothing, and another is refused."
    },
    "LabelThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "add": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`thread/label`: add labels to an open thread and take others off, journaled as a\n`labelled` event, answered with its labels after. Labels mean nothing to the Host: clients\ngive them, and filter `threads/list` and `threads/watch` by them. A labelled thread's\njournal is kept past pruning. Each label is checked with [`check_label`], and a thread\ncarries at most [`MAX_LABELS`]."
    },
    "LabelThreadResponse": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "labels"
      ]
    },
    "RunRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "Absolute, or under the Host's home as `~/…` (feature `otherHosts`), for a client that\ndoesn't know where the home is on the Host's computer."
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "The repository `cwd` has to be a checkout of (feature `otherHosts`), by its remote as\n[`crate::worktrees::GitLocation::remote`] gives it, such as `github.com/owner/name`."
        },
        "threadId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mode a new thread starts in; the agent's configured one when absent."
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "policy": {
          "$ref": "#/$defs/PermissionPolicy",
          "default": {
            "otherwise": "ask"
          }
        },
        "attach": {
          "type": "boolean",
          "description": "Attach before the prompt is sent, to see the whole turn."
        },
        "trace": {
          "type": "boolean"
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Makes it safe to send again (feature `requestKeys`). A repeat answers with the thread's\nid alone; a client that asked to attach attaches with `thread/attach`."
        },
        "caller": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtherThread"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only (feature `otherHosts`): the thread on another Host whose agent asks,\nwhich the turn's origin names, and a new thread's `startedBy` and `startedByHost`."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only: what started the turn, which its origin names."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Labels for a thread it starts, from the start (feature `labels`); an existing thread\nkeeps its own."
        }
      },
      "required": [
        "agentId",
        "cwd",
        "prompt"
      ],
      "description": "`thread/run`: open a thread (this one, or a new one) and start a turn in it, without\nthe client having to stay."
    },
    "OtherThread": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "host": {
          "type": "string",
          "description": "The Host it's on, by its id."
        },
        "hostName": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the person calls that Host."
        }
      },
      "required": [
        "threadId",
        "host"
      ],
      "description": "A thread on another of the person's Hosts (feature `otherHosts`), as a service names it."
    },
    "ServiceOrigin": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "description": "What started it, such as \"schedule daily-review\" or \"your message from iPhone\"."
        },
        "id": {
          "type": "string",
          "description": "The service's own id for it, such as a trigger's occurrence."
        }
      },
      "required": [
        "label",
        "id"
      ],
      "description": "What started a turn a service sends (ADR 0027), which its origin names."
    },
    "RunResponse": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the turn it started (feature `turnIds`)."
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadState"
            },
            {
              "type": "null"
            }
          ],
          "description": "When attached."
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "The policy the thread runs under (feature `otherHosts`): the one asked for, or an open\nthread's own. Absent from a repeat under a request key."
        }
      },
      "required": [
        "threadId"
      ]
    },
    "StartTurnRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Makes it safe to send again (feature [`REQUEST_KEYS_FEATURE`])."
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "description": "`turn/start`: send a prompt. Answered once the turn has started. The thread must be\nopen; it may be a subagent thread."
    },
    "StartTurnResponse": {
      "type": "object",
      "properties": {
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The position of the turn's `turnStarted` event."
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The turn's id (feature [`TURN_IDS_FEATURE`])."
        }
      },
      "required": [
        "seq"
      ]
    },
    "SteerTurnRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "caller": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtherThread"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only (feature `otherHosts`): the thread on another Host whose agent asks,\nwhich the steer's origin names."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only: what started the steer, which its origin names."
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "description": "`turn/steer`: a message for the thread's running turn, which joins it rather than\nstarting a turn of its own. Every attached client sees it as a `turnSteered` event, in\norder with the turn's updates. It needs an agent that takes steering, as its `initialize`\nresponse says."
    },
    "SteerTurnResponse": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/SteerOutcome"
        },
        "seq": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "The position of the message's `turnSteered` event, when it was steered."
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The id of the turn it joined, when it was steered (feature [`TURN_IDS_FEATURE`])."
        }
      },
      "required": [
        "outcome"
      ]
    },
    "SteerOutcome": {
      "oneOf": [
        {
          "type": "string",
          "const": "steered",
          "description": "It joined the running turn."
        },
        {
          "type": "string",
          "const": "notRunning",
          "description": "No turn was running by then, and nothing was sent: start a turn with it instead."
        }
      ]
    },
    "CancelTurnRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        }
      },
      "required": [
        "threadId"
      ],
      "description": "`turn/cancel`: cancel the thread's running turn and its pending requests."
    },
    "AddQueuedRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId",
          "description": "The thread's own id, not a subagent thread's."
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Makes it safe to send again (feature `requestKeys`)."
        },
        "caller": {
          "anyOf": [
            {
              "$ref": "#/$defs/OtherThread"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only (feature `otherHosts`): the thread on another Host whose agent asks,\nwhich the turn's origin names."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServiceOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "A service's only: what started the turn, which its origin names."
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "description": "`queue/add`: add a prompt to the end of the thread's queue. With no turn running and\nnothing waiting, it starts a turn at once. Adding to a paused queue resumes it."
    },
    "AddQueuedResponse": {
      "type": "object",
      "properties": {
        "queuedId": {
          "type": "string",
          "description": "The prompt's id, which is also its turn's ([`crate::turns::TurnId`])."
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The position of its `turnStarted` when it started a turn at once, otherwise of its\n`queued` event."
        },
        "started": {
          "type": "boolean",
          "description": "It started a turn at once."
        }
      },
      "required": [
        "queuedId",
        "seq",
        "started"
      ]
    },
    "RemoveQueuedRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "queuedId": {
          "type": "string"
        }
      },
      "required": [
        "threadId",
        "queuedId"
      ],
      "description": "`queue/remove`: take a prompt out of the queue, whoever added it."
    },
    "RemoveQueuedResponse": {
      "type": "object",
      "properties": {
        "removed": {
          "anyOf": [
            {
              "$ref": "#/$defs/QueuedPrompt"
            },
            {
              "type": "null"
            }
          ],
          "description": "The prompt taken out; absent when it had already left the queue, started or removed."
        }
      }
    },
    "ResumeQueueRequest": {
      "type": "object",
