      ]
    },
    "LatestTurn": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its id, unless the Host journaled it before it gave ids."
        },
        "state": {
          "$ref": "#/$defs/TurnState",
          "description": "Where it is (feature `turnIds`)."
        },
        "continues": {
          "type": [
            "string",
            "null"
          ],
          "description": "The interrupted turn it continues (WVE-144)."
        },
        "continuedIn": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its successor, for an interrupted turn the thread continued: the turn that continues it,\nstarted as this one ended (WVE-168)."
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "origin": {
          "$ref": "#/$defs/TurnOrigin"
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When it started; for a queued turn, when it was queued."
        },
        "running": {
          "type": "boolean"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/PromptResponse"
            },
            {
              "type": "null"
            }
          ],
          "description": "How it ended, once it has."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why it failed."
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent's last message in it, as text: its message chunks since the last tool call,\nthought or other message."
        }
      },
      "required": [
        "state",
        "prompt",
        "origin",
        "startedAt",
        "running"
      ],
      "description": "A thread's latest turn, or one asked for by id, as its journal records it."
    },
    "TurnState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "cancelled"
          ]
        },
        {
          "type": "string",
          "const": "queued",
          "description": "Its prompt waits in the thread's queue."
        },
        {
          "type": "string",
          "const": "waiting",
          "description": "It runs, and a permission request or elicitation in it waits for a person."
        },
        {
          "type": "string",
          "const": "ended",
          "description": "It ended as the agent meant it to (`end_turn`)."
        },
        {
          "type": "string",
          "const": "stopped",
          "description": "It stopped short: the agent's token limit, a refusal, too many model requests."
        },
        {
          "type": "string",
          "const": "failed",
          "description": "It failed, or ended unexplained."
        },
        {
          "type": "string",
          "const": "interrupted",
          "description": "The Host stopped or crashed while it ran (WVE-144). A headless thread continues it in a\nturn of its own."
        }
      ],
      "description": "Where a turn is: waiting to start, running, waiting on a person, or how it ended. The\nendings match the exit statuses of `weave run` and `weave threads follow`."
    },
