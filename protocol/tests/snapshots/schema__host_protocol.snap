            "$ref": "#/$defs/SessionListing"
          }
        }
      },
      "required": [
        "sessions"
      ]
    },
    "UnwatchSessionsRequest": {
      "type": "object",
      "description": "`sessions/unwatch`: stop what `sessions/watch` sends."
    },
    "CreateSessionRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mode to start in; the agent's configured one when absent."
