  "x-weave-dispatcher-notifications": {
    "devices/paired": "DevicePairedNotification",
    "bots/updated": "BotUpdatedNotification",
    "bots/removed": "BotRemovedNotification"
  },
  "x-weave-constants": {
    "protocol": {
      "version": 3,
      "oldestSupported": 3
    },
    "websocket": {
      "appOrigin": "capacitor://localhost",
      "maxMessage": 33554432,
      "closeRevoked": 4000,
      "closeBehind": 4001,
      "closeUnauthenticated": 4002
    },
    "dispatcher": {
      "protocol": 2,
      "subprotocol": "weave-dispatcher",
      "hostSubprotocol": "weave-dispatcher-host",
      "carrySubprotocol": "weave-dispatcher-carry",
      "authMessage": "weave-dispatcher-auth/1 {dispatcherId} {deviceId} {nonce}",
      "features": {
        "projects": "projects",
        "bots": "bots",
        "botsHome": "bots_home",
        "botsWatch": "bots_watch",
        "botsAvatar": "bots_avatar"
      },
      "defaultPauseAfter": 43200000
    },
    "terminalStream": {
      "subprotocol": "weave-terminal",
      "ticketLifetimeMs": 30000,
      "restore": 1,
      "output": 3,
      "input": 16,
      "closeTicket": 4010,
      "closeExited": 4011
    },
    "errors": {
      "unauthenticated": -32060,
      "incompatibleProtocol": -32061,
      "unknownAgent": -32062,
      "unknownThread": -32063,
      "threadNotOpen": -32064,
      "turnRunning": -32065,
      "alreadyResolved": -32066,
      "wrongAgent": -32067,
      "requiresTerminal": -32068,
      "forbidden": -32069,
      "notTarget": -32070,
      "remoteUnavailable": -32071,
      "worktreeBusy": -32072,
      "notARepository": -32073,
      "gitFailed": -32074,
      "uncommittedChanges": -32075,
      "keyReused": -32076,
      "hostStopping": -32077,
      "unknownTerminal": -32078,
      "terminalUnavailable": -32079,
      "unknownTurn": -32080,
      "hostUnavailable": -32081,
      "interrupted": -32082,
      "noSession": -32083,
      "revisionConflict": -32084,
      "sessionBusy": -32085
    },
    "features": {
      "steer": "turn/steer",
      "agentUpdates": "agents/updates",
      "clientTools": "clientTools",
      "watch": "threads/watch",
      "listFiles": "files/list",
      "rename": "thread/rename",
      "worktrees": "worktrees",
      "reposInit": "repos_init",
      "queue": "queue",
      "getThread": "threads/get",
      "requestKeys": "requestKeys",
      "drain": "drain",
      "terminals": "terminals",
      "turnIds": "turnIds",
      "otherHosts": "otherHosts",
      "mcpServers": "mcpServers",
      "sessionsEnd": "sessions_end",
      "sessionsAdd": "sessions_add",
      "carry": "carry",
      "sessions": "sessions"
    },
    "files": {
      "maxEntries": 2000
    },
    "threads": {
      "maxTitle": 200
    },
    "sessions": {
      "maxLayout": 1048576,
      "layoutVersion": 2
    },
    "requestKeys": {
      "maxKey": 200
    },
    "clientTools": {
      "clipboardWrite": "clipboard_write"
    },
    "hostTools": {
      "renameThread": "rename_thread",
      "listThreads": "list_threads",
      "readThread": "read_thread",
      "startThread": "start_thread",
      "promptThread": "prompt_thread",
      "steerThread": "steer_thread",
      "cancelThreadTurn": "cancel_thread_turn",
      "listAgents": "list_agents",
      "listHosts": "list_hosts"
    }
  },
  "$defs": {
    "HelloRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/VersionRange",
          "description": "The major versions the client speaks."
        },
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "auth": {
          "$ref": "#/$defs/Auth"
        },
        "capabilities": {
          "$ref": "#/$defs/ClientCapabilities",
          "default": {
            "terminalSignIn": false
          }
        }
      },
      "required": [
        "protocol",
        "client",
        "auth"
      ]
    },
    "VersionRange": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "description": "A range of major versions, both ends included."
    },
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "What the client is, such as `weave-tui`."
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Auth": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "local"
            }
          },
          "required": [
            "method"
          ],
          "description": "The socket's peer is the Host's own user. Only on the Unix socket and in-process."
        },
        {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            },
            "method": {
              "type": "string",
              "const": "token"
            }
          },
          "required": [
            "method",
            "token"
          ],
          "description": "Reserved, and refused everywhere; the next major version removes it."
        },
        {
          "type": "object",
          "properties": {
            "deviceId": {
              "type": "string"
            },
            "signature": {
              "type": "string",
              "description": "The DER-encoded ECDSA P-256 SHA-256 signature, in unpadded base64url."
            },
            "method": {
              "type": "string",
              "const": "device"
            }
          },
          "required": [
            "method",
            "deviceId",
            "signature"
          ],
          "description": "A paired device's signature of the connection's challenge. To a Host, only the Dispatcher\nit joined says it, on the connection the Host opened to it, signing its\n[`ChallengeRequest`] as [`crate::devices::auth_message`] spells it.\nTo the Dispatcher, a device it paired with, as\n[`crate::dispatcher::dispatcher_auth_message`] spells it."
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "device": {
              "$ref": "#/$defs/NewDevice"
            },
            "method": {
              "type": "string",
              "const": "pair"
            }
          },
          "required": [
            "method",
            "code",
            "device"
          ],
          "description": "A device pairing with the Dispatcher, on its WebSocket, with the code `weave pair`\nshowed. The connection is that device's from then on. Hosts refuse it: they pair with\nnothing (WVE-197)."
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "type": "string",
              "const": "dispatcher"
            }
          },
          "required": [
            "method"
          ],
          "description": "The device the Dispatcher named in `dispatcher/carry` (ADR 0030, WVE-195), on a\nconnection the Host opened to the Dispatcher to carry that device's: only there."
        }
      ],
      "description": "How a connection authenticates. The Dispatcher's own hello takes it too\n([`crate::dispatcher::DispatcherHelloRequest`]), where a device pairs and proves its key; a\nHost takes only `local`, the Dispatcher it joined proving its key with `device`, and\n`dispatcher`."
    },
    "NewDevice": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "What the person calls it, such as \"Jaco's iPad\". An offer made with a name uses that\ninstead."
        },
        "publicKey": {
          "$ref": "#/$defs/Jwk"
        },
        "service": {
          "type": "boolean",
          "description": "A service pairing, which may do only what it needs (ADR 0027)."
        }
      },
      "required": [
        "name",
        "publicKey"
      ],
      "description": "A device pairing, as it introduces itself."
    },
    "Jwk": {
      "type": "object",
      "properties": {
        "kty": {
          "type": "string",
          "description": "`EC`."
        },
        "crv": {
          "type": "string",
          "description": "`P-256`."
        },
        "x": {
          "type": "string"
        },
        "y": {
          "type": "string"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "description": "A P-256 public key as a JWK: `x` and `y` are its coordinates, 32 bytes each, in unpadded\nbase64url."
    },
    "ClientCapabilities": {
      "type": "object",
      "properties": {
        "terminalSignIn": {
          "type": "boolean",
          "description": "The client can run an agent's sign-in command in a terminal on the Host's computer.\nOnly local clients may say so.",
          "default": false
        },
        "clientTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The client tools ([`crate::tools`]) this client runs on its device."
        }
      }
    },
    "HelloResponse": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "The version this connection speaks: the highest both ends do."
        },
        "clientId": {
          "type": "string"
        },
        "host": {
          "$ref": "#/$defs/HostInfo"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional parts of the protocol this Host supports.",
          "default": []
        },
        "acp": {
          "$ref": "#/$defs/AcpInfo"
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The device a remote client connected as: the one the Dispatcher named for a connection\nit carries, or the Dispatcher itself on the Host's own connection to it. None for a local\nclient."
        }
      },
      "required": [
        "protocol",
        "clientId",
        "host",
        "acp"
      ]
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The Host's own id, which stays the same across restarts, so clients tell Hosts apart.",
          "default": ""
        },
        "version": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "pid",
        "startedAt"
      ]
    },
    "AcpInfo": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The ACP protocol version the Host speaks to agents."
        },
        "unstable": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Unstable ACP features the Host may pass through, such as `subagents`.",
          "default": []
        }
      },
      "required": [
        "protocolVersion"
      ],
      "description": "Which ACP payloads to expect."
    },
    "DeviceInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "service": {
          "type": "boolean",
          "description": "Whether the device is a service."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "description": "Which device a connection is."
    },
    "ChallengeRequest": {
      "type": "object",
      "description": "`host/challenge`: what the Dispatcher a Host joined signs in its `host/hello`. Only on the\nconnection the Host opened to it, before hello."
    },
    "ChallengeResponse": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "description": "The Host's id, which the Dispatcher checks is the Host that joined it."
        },
        "nonce": {
          "type": "string",
          "description": "32 random bytes, in unpadded base64url, good for one hello on this connection."
        },
        "expiresAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "hostId",
        "nonce",
        "expiresAt"
      ]
    },
    "StatusRequest": {
      "type": "object",
      "description": "`host/status`."
    },
    "HostStatus": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "service": {
          "$ref": "#/$defs/Service"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentSource"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThreadListing"
          },
          "description": "The open threads."
        },
        "serveEntry": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServeEntryLeft"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Tailscale Serve entry the Host made for remote clients before they reached it through\nthe Dispatcher (ADR 0030, WVE-197), while it's there and the Host couldn't remove it."
        },
        "dispatcher": {
          "anyOf": [
            {
              "$ref": "#/$defs/JoinedDispatcher"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Dispatcher the Host joined, and its connection to it (ADR 0030)."
        }
      },
      "required": [
        "protocol",
        "version",
        "pid",
        "startedAt",
        "service",
        "environment",
        "threads"
      ]
    },
    "Service": {
      "oneOf": [
        {
          "type": "string",
          "const": "launchd",
          "description": "As a launchd user agent, with no idle exit."
        },
        {
          "type": "string",
          "const": "systemd",
          "description": "As a systemd user service, with no idle exit."
        },
        {
          "type": "string",
          "const": "onDemand",
          "description": "Started by a client, exiting once idle."
        },
        {
          "type": "string",
          "const": "inProcess",
          "description": "Inside a client (`--no-daemon`)."
        }
      ],
      "description": "How the Host runs."
    },
    "EnvironmentSource": {
      "oneOf": [
        {
          "type": "string",
          "const": "loginShell",
          "description": "The user's login shell, over the Host's own."
        },
        {
          "type": "string",
          "const": "process",
          "description": "The Host's own only: capturing the login shell's failed."
        }
      ],
      "description": "Where agents' environment comes from."
    },
    "ThreadListing": {
      "type": "object",
      "properties": {
        "info": {
          "$ref": "#/$defs/SessionInfo",
          "description": "As ACP lists it: id, directory, title, last update."
        },
        "agentId": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "activity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Activity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Open threads only."
        },
        "clients": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "headless": {
          "type": "boolean",
          "description": "A permission policy answers its requests, so it runs with nobody attached.",
          "default": false
        },
        "lastActivityAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where in a git repository its directory is, as the Host last read it while the thread\nwas open; absent outside one, and for threads the Host has no record of."
        },
        "startedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The thread whose agent started it, for a delegated thread."
        },
        "startedByHost": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Host the thread that started it is on, when it isn't this one."
        },
        "continuedIn": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its successor (feature `successors`, WVE-168): the thread its work goes on in, which a\nclient named with `thread/setSuccessor`. Clients following this one may follow that,\nand reports to this one go there."
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its labels (feature `labels`, WVE-173), in order, which clients gave it and filter by."
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextUsage"
            },
            {
              "type": "null"
            }
          ],
          "description": "How much of its agent's context window it uses (feature `context`, WVE-174), from its\nlatest ACP `usage_update`."
        },
        "lastCompaction": {
          "anyOf": [
            {
              "$ref": "#/$defs/LastCompaction"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its last completed compaction (feature `context`), from ACP's `compaction_update`; absent\nfor an agent that reports compaction otherwise, as Codex's adapter does in text."
        },
        "openedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnOrigin"
            },
            {
              "type": "null"
            }
          ],
          "description": "The client whose `thread/create` or `thread/attach` opened it last, while it's open:\na paired device's names its `device`. A service's `thread/run` that opened it gives\nthe turn's origin. Absent for one another headless run or a Host taking it up opened."
        },
        "openedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it opened last, while it's open."
        }
      },
      "required": [
        "info",
        "agentId",
        "state"
      ]
    },
    "SessionInfo": {
      "type": "object",
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/SessionId",
          "description": "Unique identifier for the session"
        },
        "cwd": {
          "type": "string",
          "description": "The working directory for this session. Must be an absolute path."
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional workspace roots reported for this session. Each path must be absolute.\n\nWhen present, this is the complete ordered additional-root list reported\nby the Agent. Omitted and empty values are equivalent: the response\nreports no additional roots.",
          "x-deserialize-default-on-error": true,
          "x-deserialize-skip-invalid-items": true
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title for the session",
          "x-deserialize-default-on-error": true
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 timestamp of last activity",
          "x-deserialize-default-on-error": true
        },
        "_meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The _meta property is reserved by ACP to allow clients and agents to attach additional\nmetadata to their interactions. Implementations MUST NOT make assumptions about values at\nthese keys.\n\nSee protocol docs: [Extensibility](https://agentclientprotocol.com/protocol/v1/extensibility)",
          "x-deserialize-default-on-error": true
        }
      },
      "required": [
        "sessionId",
        "cwd"
      ],
      "description": "Information about a session returned by session/list"
    },
    "SessionId": {
      "type": "string",
      "description": "A unique identifier for a conversation session between a client and agent.\n\nEach session has its own context, conversation history, and state, so one\nagent can run several independent sessions.\n\nSee protocol docs: [Session ID](https://agentclientprotocol.com/protocol/v1/session-setup#session-id)"
    },
    "ThreadStatus": {
      "oneOf": [
        {
          "type": "string",
          "const": "open",
          "description": "The Host holds it and its agent runs."
        },
        {
          "type": "string",
          "const": "suspended",
          "description": "It was open when its Host stopped; attaching opens it again from its journal."
        },
        {
          "type": "string",
          "const": "closed",
          "description": "The Host no longer holds it; attaching opens it again from the agent's history."
        }
      ]
    },
    "Activity": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "idle",
            "running"
          ]
        },
        {
          "type": "string",
          "const": "waiting",
          "description": "A pending request waits for a person."
        }
      ],
      "description": "What an open thread is doing."
    },
    "GitLocation": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "The repository, by its primary worktree."
        },
        "worktree": {
          "type": "string",
          "description": "The worktree the directory is in: the primary one or another."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "description": "The branch checked out there; absent when its HEAD is detached."
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "The repository's remote as a host and path, such as `github.com/owner/name`, without\ncredentials or `.git`: `origin`, or else the first. Absent without one, or for a remote\nthat's a path on this computer."
        }
      },
      "required": [
        "repo",
        "worktree"
      ],
      "description": "Where in a git repository a thread's directory is, as the Host last read it: when the\nthread opened, and again after each of its turns."
    },
    "ContextUsage": {
      "type": "object",
      "properties": {
        "used": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used",
        "size"
      ],
      "description": "A thread's context usage, as its agent last reported it: tokens in context, of the window."
    },
    "LastCompaction": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "used": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "at"
      ],
      "description": "A thread's last completed compaction: when it completed, and the tokens in context its\nagent reported next, once it has."
    },
    "TurnOrigin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "client": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "device": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "id"
              ]
            }
          },
          "required": [
            "client"
          ],
          "additionalProperties": false,
          "description": "A client's prompt: its name, and its connection, so it knows its own prompts. A\nremote client's names its device too."
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "object"
            }
          },
          "required": [
            "run"
          ],
          "additionalProperties": false,
          "description": "A headless run."
        },
        {
          "type": "object",
          "properties": {
            "thread": {
              "type": "object",
              "properties": {
                "threadId": {
                  "$ref": "#/$defs/SessionId"
                },
                "host": {
                  "description": "The Host that thread is on, when it isn't this one: the id of another of the\nperson's Hosts, as the service that reaches them gave it (ADR 0029).",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "hostName": {
                  "description": "What the person calls that Host, as the service gave it, for clients to show.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "report": {
                  "description": "The Host's report on that thread, of how a turn this thread's agent began there\nended or that it waits on a person. Nobody hears how a report's turn ends.",
                  "type": "boolean"
                }
              },
              "required": [
                "threadId"
              ]
            }
          },
          "required": [
            "thread"
          ],
          "additionalProperties": false,
          "description": "Another thread: one whose agent began the turn through a Host tool, or, in a report,\nthe thread the Host reports on (ADR 0023)."
        },
        {
          "type": "object",
          "properties": {
            "service": {
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name the service paired with, which the Host gives, never the request.",
                  "type": "string"
                },
                "label": {
                  "description": "What started the turn, such as \"schedule daily-review\".",
                  "type": "string"
                },
                "id": {
                  "description": "The service's own id for it, such as a trigger's occurrence.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "label",
                "id"
              ]
            }
          },
          "required": [
            "service"
          ],
          "additionalProperties": false,
          "description": "A service's turn (ADR 0027), naming what started it in the service's own words."
        }
      ],
      "description": "Who started a turn."
    },
    "ServeEntryLeft": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "The HTTPS port it serves on the computer's tailnet name."
        },
        "command": {
          "type": "string",
          "description": "What removes it, for the person to run on the Host's computer, such as\n`sudo tailscale serve --https=7341 off`."
        },
        "why": {
          "type": "string",
          "description": "Why the Host couldn't."
        }
      },
      "required": [
        "port",
        "command",
        "why"
      ],
      "description": "A Tailscale Serve entry the Host made for remote clients before they reached it through the\nDispatcher, which it couldn't remove itself, as where only root may change Serve."
    },
    "JoinedDispatcher": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "What the Dispatcher calls itself."
        },
        "address": {
          "$ref": "#/$defs/DispatcherAddress"
        },
        "hostName": {
          "type": "string",
          "description": "What the Dispatcher calls this Host."
        },
        "joinedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "connected": {
          "type": "boolean",
          "description": "Connected now."
        },
        "connectedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it last connected."
        },
        "why": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the last connection failed or closed, when it did."
        }
      },
      "required": [
        "id",
        "name",
        "address",
        "hostName",
        "joinedAt",
        "connected"
      ],
      "description": "The Dispatcher a Host joined, and its connection to it."
    },
    "DispatcherAddress": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "socket": {
              "type": "string"
            }
          },
          "required": [
            "socket"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Where a Host reaches the Dispatcher: its WebSocket, through its Tailscale Serve entry, or on\nthe Dispatcher's own computer the socket in its directory that Hosts connect to."
    },
    "DrainRequest": {
      "type": "object",
      "properties": {
        "wait": {
          "type": "boolean",
          "description": "Wait for running turns before answering.",
          "default": false
        },
        "except": {
          "type": [
            "string",
            "null"
          ],
          "description": "The agent process whose turn isn't waited for, from the `WEAVE_AGENT_PROCESS` the\nHost gives each agent: the one asking, when an agent stops the Host."
        }
      },
      "description": "`host/drain`: get ready to stop. From now on the Host starts no new turns (`turn/start`\nand `thread/run` answer `host_stopping`, and queued prompts wait), and with `wait` it\nanswers once no turn runs but `except`'s, or when its drain timeout passes. The stop that\nfollows doesn't wait again. If the asking client goes before the Host stops, the drain\nends. Local clients only."
    },
    "DrainResponse": {
      "type": "object",
      "properties": {
        "running": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Turns still running, but for `except`'s, which stopping cuts off."
        }
      },
      "required": [
        "running"
      ]
    },
    "ShutdownRequest": {
      "type": "object",
      "description": "`host/shutdown`: suspend every open thread and exit."
    },
    "Empty": {
      "type": "object",
      "description": "A response with nothing in it."
    },
    "ListAgentsRequest": {
      "type": "object",
      "properties": {
        "includeRegistry": {
          "type": "boolean",
          "default": false
        },
        "refresh": {
          "type": "boolean",
          "description": "Fetch the registry's catalog again.",
          "default": false
        }
      },
      "description": "`agents/list`: presets and configured agents, and registry agents when asked."
    },
    "ListAgentsResponse": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentSummary"
          }
        },
        "defaultAgent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agents"
      ]
    },
    "AgentSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "The agent's title when known, else its id."
        },
        "source": {
          "$ref": "#/$defs/AgentSource"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "description": "The pinned preset or registry version."
        },
        "installed": {
          "type": "boolean",
          "description": "False for a registry agent not downloaded yet."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "source",
        "installed"
      ]
    },
    "AgentSource": {
      "type": "string",
      "enum": [
        "preset",
        "config",
        "registry"
      ]
    },
    "GetAgentRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        }
      },
      "required": [
        "agentId"
      ],
      "description": "`agents/get`: what the agent says about itself, starting it to ask if need be."
    },
    "GetAgentResponse": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/$defs/AgentSummary"
        },
        "initialize": {
          "$ref": "#/$defs/InitializeResponse"
        }
      },
      "required": [
        "agent",
        "initialize"
      ]
    },
    "InitializeResponse": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the client specified if supported by the agent,\nor the latest protocol version supported by the agent.\n\nThe client should disconnect, if it doesn't support this version."
        },
        "agentCapabilities": {
          "$ref": "#/$defs/AgentCapabilities",
          "description": "Capabilities supported by the agent.",
          "default": {
            "loadSession": false,
            "promptCapabilities": {
              "image": false,
              "audio": false,
              "embeddedContext": false
            },
            "mcpCapabilities": {
              "http": false,
              "sse": false,
              "acp": false
            },
            "sessionCapabilities": {},
            "auth": {}
          },
          "x-deserialize-default-on-error": true
        },
        "authMethods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AuthMethod"
          },
          "description": "Authentication methods supported by the agent.",
          "default": [],
          "x-deserialize-default-on-error": true,
          "x-deserialize-skip-invalid-items": true
        },
        "agentInfo": {
          "anyOf": [
            {
              "$ref": "#/$defs/Implementation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Information about the Agent name and version sent to the Client.\n\nNote: in future versions of the protocol, this will be required.",
          "x-deserialize-default-on-error": true
        },
        "_meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The _meta property is reserved by ACP to allow clients and agents to attach additional\nmetadata to their interactions. Implementations MUST NOT make assumptions about values at\nthese keys.\n\nSee protocol docs: [Extensibility](https://agentclientprotocol.com/protocol/v1/extensibility)",
          "x-deserialize-default-on-error": true
        }
      },
      "required": [
        "protocolVersion"
      ],
      "description": "Response to the `initialize` method.\n\nContains the negotiated protocol version and agent capabilities.\n\nSee protocol docs: [Initialization](https://agentclientprotocol.com/protocol/v1/initialization)",
      "x-side": "agent",
      "x-method": "initialize"
    },
    "ProtocolVersion": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535,
      "description": "Protocol version identifier.\n\nThis version is only bumped for breaking changes.\nNon-breaking changes should be introduced via capabilities."
    },
    "AgentCapabilities": {
      "type": "object",
      "properties": {
        "loadSession": {
          "type": "boolean",
          "description": "Whether the agent supports `session/load`.",
          "default": false,
          "x-deserialize-default-on-error": true
        },
        "promptCapabilities": {
          "$ref": "#/$defs/PromptCapabilities",
          "description": "Prompt capabilities supported by the agent.",
          "default": {
            "image": false,
            "audio": false,
            "embeddedContext": false
          },
          "x-deserialize-default-on-error": true
        },
        "mcpCapabilities": {
          "$ref": "#/$defs/McpCapabilities",
          "description": "MCP capabilities supported by the agent.",
          "default": {
            "http": false,
            "sse": false,
            "acp": false
          },
          "x-deserialize-default-on-error": true
        },
        "sessionCapabilities": {
          "$ref": "#/$defs/SessionCapabilities",
          "description": "Session lifecycle and prompt capabilities advertised by the agent.",
          "default": {},
          "x-deserialize-default-on-error": true
        },
        "auth": {
