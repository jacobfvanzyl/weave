        "client"
      ],
      "description": "`dispatcher/hello`: the first request on a connection. Until it succeeds, the Dispatcher\nanswers every other request with [`crate::errors::UNAUTHENTICATED`]."
    },
    "DispatcherHello": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "string",
          "description": "The weave release the Dispatcher runs."
        },
        "id": {
          "type": "string",
          "description": "The Dispatcher's own id, which stays the same across restarts and which a device checks\nis the Dispatcher it paired with.",
          "default": ""
        },
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeviceInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "The paired device a remote client connected as; none for a local client."
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional parts of its API it answers, such as [`PROJECTS_FEATURE`]. A Dispatcher from\nbefore them says none.",
          "default": []
        }
      },
      "required": [
        "protocol",
        "version"
      ]
    },
    "DispatcherStatusRequest": {
      "type": "object",
      "description": "`dispatcher/status`."
    },
    "DispatcherStatus": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "description": "What it calls itself to the Hosts that join it."
        },
        "database": {
          "type": "string",
          "description": "Its database."
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Work written down for a Host that the Host hasn't taken yet."
        },
        "id": {
          "type": "string",
          "description": "Its id, which its paired devices know it by.",
          "default": ""
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where its WebSocket listens, while a paired device or a Host that joined over it keeps\nremote access on."
        },
        "devices": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "The devices paired with it.",
          "default": 0
        }
      },
      "required": [
        "version",
        "pid",
        "startedAt",
        "name",
        "database",
        "pending"
      ]
    },
    "OfferDeviceRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "The name the device gets, instead of the one it gives."
        }
      },
      "description": "`devices/offer`: a one-time code a device pairs with, good for five minutes."
    },
    "OfferDeviceResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "128 random bits in Crockford base32."
        },
        "expiresAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "What devices connect to: the Dispatcher's Tailscale Serve URL, or the one its `--url`\ngives. Offering turns its WebSocket on, so it gives one whenever it takes devices."
        }
      },
      "required": [
        "code",
        "expiresAt"
      ]
    },
    "ListDevicesRequest": {
      "type": "object",
      "description": "`devices/list`."
    },
    "ListDevicesResponse": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        }
      },
      "required": [
        "devices"
      ]
    },
    "Device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pairedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "lastSeenAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it last said hello, if it has since pairing."
        },
        "connections": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Its connections now."
        },
        "service": {
          "type": "boolean",
          "description": "Whether the device is a service."
        }
      },
      "required": [
        "id",
        "name",
        "pairedAt",
        "connections"
      ],
      "description": "A paired device, as `devices/list` shows it."
    },
    "RevokeDeviceRequest": {
      "type": "object",
      "properties": {
        "deviceId": {
          "type": "string"
        }
      },
      "required": [
        "deviceId"
      ],
      "description": "`devices/revoke`: forget a device and close its connections. It has to pair again."
    },
    "ListHostsRequest": {
      "type": "object",
      "description": "`hosts/list`."
    },
    "ListHostsResponse": {
      "type": "object",
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DispatcherHost"
          }
        }
      },
      "required": [
        "hosts"
      ]
    },
    "DispatcherHost": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "What the Dispatcher calls it."
        },
        "url": {
          "type": "string",
          "description": "Where the Dispatcher dialed it, for a Host paired before Hosts joined it\n([`Reachability::Unjoined`]); empty for one that joined.",
          "default": ""
        },
        "deviceId": {
          "type": "string",
          "description": "The device the Host knows the Dispatcher as."
        },
        "pairedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When it first paired or joined."
        },
        "joinedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it last joined; none for a Host paired before Hosts joined the Dispatcher."
        },
        "here": {
          "type": "boolean",
          "description": "It joined over the Dispatcher's socket, on the Dispatcher's own computer."
        },
        "connected": {
          "type": "boolean",
          "description": "Connected now."
        },
        "status": {
          "$ref": "#/$defs/Reachability",
          "description": "How the last attempt to connect went."
        },
        "why": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it failed, when it did."
        },
        "connectedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it last connected."
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Work written down for it that it hasn't taken yet."
        }
      },
      "required": [
        "hostId",
        "name",
        "deviceId",
        "pairedAt",
        "connected",
        "status",
        "pending"
      ],
      "description": "A Host that joined the Dispatcher, which is a client of it with the `service` role."
    },
    "Reachability": {
      "oneOf": [
        {
          "type": "string",
          "const": "reachable",
          "description": "It took the Dispatcher's key at hello; the Dispatcher may be connected to it now."
        },
        {
          "type": "string",
          "const": "unchecked",
          "description": "It hasn't connected since the Dispatcher started."
        },
        {
          "type": "string",
          "const": "refused",
          "description": "It left the Dispatcher, or refused its key: joining again is the way back."
        },
        {
          "type": "string",
          "const": "unjoined",
          "description": "It was paired before Hosts joined the Dispatcher (ADR 0030), which no longer dials it:\n`weave hosts add` there joins it."
        },
        {
          "type": "string",
          "const": "down",
          "description": "Its computer answered at the URL, but no weave Host did, as when the Host isn't running\nthere."
        },
        {
          "type": "string",
          "const": "unreachable",
          "description": "Nothing answered at the URL, as when the computer is asleep or off the tailnet."
        },
        {
          "type": "string",
          "const": "otherHost",
          "description": "Another weave Host answers at the URL."
        }
      ],
      "description": "How the Dispatcher's last attempt to connect to a Host went."
    },
    "OfferHostRequest": {
      "type": "object",
      "properties": {
        "here": {
          "type": "boolean"
        }
      },
      "description": "`hosts/offer`: a one-time code a Host joins the Dispatcher with, good for five minutes\n(ADR 0030). For a Host on another computer it turns the Dispatcher's WebSocket on, as\n`devices/offer` does, and gives its URL. For one on the Dispatcher's own computer (`here`),\nwhich only a client there may ask for, it gives the socket Hosts connect to instead."
    },
    "OfferHostResponse": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "128 random bits in Crockford base32."
        },
        "expiresAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "address": {
          "$ref": "#/$defs/DispatcherAddress",
          "description": "Where the Host connects to join."
        }
      },
      "required": [
        "code",
        "expiresAt",
        "address"
      ]
    },
    "ConnectHostRequest": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "[`DISPATCHER_PROTOCOL`] as the Host speaks it."
        },
        "hostId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "What the Host calls itself, which the Dispatcher calls it when it joins."
        },
        "version": {
          "type": "string",
          "description": "The weave release the Host runs."
        },
        "signature": {
          "type": "string"
        },
        "join": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostJoin"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "protocol",
        "hostId",
        "name",
        "version",
        "signature"
      ],
      "description": "`hosts/connect`: the request a Host's own connection begins with, after\n`dispatcher/challenge`: who it is, and its signature of the challenge, as\n[`host_connect_message`] spells it. Joining, it gives the code `hosts/offer` showed and the\nkey it signs with. Once the Dispatcher answers, it says `host/hello` to the Host on the same\nconnection; a refusal answers [`crate::errors::UNAUTHENTICATED`] and closes it."
    },
    "HostJoin": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "publicKey": {
          "$ref": "#/$defs/Jwk"
        }
      },
      "required": [
        "code",
        "publicKey"
      ],
      "description": "A Host joining: the code `hosts/offer` gave, and the Host's P-256 public key."
    },
    "HostConnected": {
      "type": "object",
      "properties": {
        "dispatcherId": {
          "type": "string"
        },
        "dispatcherName": {
          "type": "string",
          "description": "What the Dispatcher calls itself."
        },
        "publicKey": {
          "$ref": "#/$defs/Jwk",
          "description": "The Dispatcher's P-256 public key. At `host/hello` it signs the Host's challenge with it,\nas [`crate::devices::auth_message`] spells it, with its id as the device's."
        },
        "name": {
          "type": "string",
          "description": "What the Dispatcher calls the Host."
        }
      },
      "required": [
        "dispatcherId",
        "dispatcherName",
        "publicKey",
        "name"
      ]
    },
    "RemoveHostRequest": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "description": "`hosts/remove`: forget a Host, by id or name, and the work still written down for it. A\nHost connected now is told, as its connection closes with\n[`crate::websocket::CLOSE_REVOKED`], and forgets that it joined."
    },
    "OpenHostRequest": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "By id or name, as `hosts/list` gives them."
        },
        "stream": {
          "$ref": "#/$defs/CarriedStream",
          "default": "host"
        }
      },
      "required": [
        "host"
      ],
      "description": "`hosts/open`: the last request on a connection a device asks the Dispatcher to carry to one\nof the person's Hosts (ADR 0030, WVE-195), after its challenge and hello: on the WebSocket\nwith [`DISPATCHER_CARRY_SUBPROTOCOL`], or on the Dispatcher's socket on its own computer. The\nDispatcher answers once the Host has opened a connection of its own to be joined to this one,\nand from then on passes what either sends to the other unchanged. A Host it isn't connected\nto answers [`crate::errors::HOST_UNAVAILABLE`] at once, with [`HostUnavailable`] as its data."
    },
    "OpenedHost": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "What the Dispatcher calls it."
        }
      },
      "required": [
        "hostId",
        "name"
      ]
    },
    "HostCarryRequest": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "nonce": {
          "type": "string",
          "description": "32 random bytes, in unpadded base64url, fresh for this connection."
        }
      },
      "required": [
        "token",
        "nonce"
      ],
      "description": "`hosts/carry`: on a connection a Host opens to the Dispatcher it joined with\n[`DISPATCHER_HOST_SUBPROTOCOL`], after `dispatcher/challenge`, in place of `hosts/connect`:\nthe token a [`CarryRequest`] gave it, and a nonce of the Host's own, which the Dispatcher\nsigns ([`HostCarried`]). Once the Host has checked the signature with the key it learned when\nit joined, the connection is the Host's end of the device's, and the Host serves it; without\nthe signature, or with a wrong one, the Host closes it, serving nothing."
    },
    "HostCarried": {
      "type": "object",
      "properties": {
        "signature": {
          "type": "string",
          "description": "The Dispatcher's signature of [`carry_message`] with its own key, as a device's in\n`host/hello`: DER, in unpadded base64url."
        }
      },
      "required": [
        "signature"
      ]
    },
    "ListSchedulesRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": [
            "string",
            "null"
          ],
          "description": "By id or name; invalid params for none."
        }
      },
      "description": "`schedules/list`: every schedule, or with `bot` (feature `bots_home`) only the schedules\nthat prompt that Bot, its wake-ups included."
    },
    "ListSchedulesResponse": {
      "type": "object",
      "properties": {
        "schedules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Schedule"
          }
        }
      },
      "required": [
        "schedules"
      ]
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "cron": {
          "type": "string",
          "description": "Five fields, minute to weekday, or a name such as `@daily`; empty for a one-off."
        },
        "at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "A one-off's time, its one occurrence's (feature `bots`)."
        },
        "zone": {
          "type": "string",
          "description": "An IANA time zone, such as `Africa/Johannesburg`."
        },
        "hostId": {
          "type": "string"
        },
        "hostName": {
          "type": "string"
        },
        "botId": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Bot each occurrence prompts, for a Bot's schedule (feature `bots`): `run` gives its\nagent, home as `cwd`, policy, mode and current thread."
        },
        "botName": {
          "type": [
            "string",
            "null"
          ]
        },
        "wakeUp": {
          "type": "boolean",
          "description": "The Bot asked for it itself, from one of its threads, with the Dispatcher's `wake_me`\ntool (feature `bots`): a one-off, which the Dispatcher forgets a week after its time once\nits occurrence is over. Absent for the person's own schedules."
        },
        "agentId": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "policy": {
          "$ref": "#/$defs/PermissionPolicy"
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mode a new thread starts in; the agent's configured one when absent."
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The thread each occurrence prompts; each starts a new one when absent."
        },
        "missed": {
          "$ref": "#/$defs/Missed"
        },
        "overlap": {
          "$ref": "#/$defs/Overlap"
        },
        "createdAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "paused": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it's paused, when it is: by the person, or after failing."
        },
        "failures": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Its occurrences that failed or were interrupted in a row."
        },
        "nextAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When it next runs, unless it's paused; absent for a one-off once its time has come."
        },
        "next": {
          "type": [
            "string",
            "null"
          ],
          "description": "That, in its time zone: \"Wed 4 Nov 09:00 SAST\"."
        },
        "last": {
          "anyOf": [
            {
              "$ref": "#/$defs/Occurrence"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its latest occurrence."
        }
      },
      "required": [
        "id",
        "name",
        "cron",
        "zone",
        "hostId",
        "hostName",
        "agentId",
        "cwd",
        "prompt",
        "policy",
        "missed",
        "overlap",
        "createdAt",
        "failures"
      ],
      "description": "A schedule: a trigger whose occurrences start a headless turn on one of the person's Hosts\nat the times its cron expression gives, in its time zone, or once at the time it names (a\none-off). A Bot's schedule prompts the Bot (WVE-118): its Host, agent, directory, policy,\nmode and thread are the Bot's as it lists now."
    },
    "Missed": {
      "oneOf": [
        {
          "type": "string",
          "const": "latest",
          "description": "Run the latest missed occurrence once, late, within the look-back; skip the rest."
        },
        {
          "type": "string",
          "const": "skip",
          "description": "Skip every missed occurrence."
        }
      ],
      "description": "What a schedule does about an occurrence it missed, as while its computer slept."
    },
    "Overlap": {
      "oneOf": [
        {
          "type": "string",
          "const": "skip",
          "description": "Skip it."
        },
        {
          "type": "string",
          "const": "allow",
          "description": "Start it anyway, in a thread of its own: only for a schedule that starts a new thread\neach time."
        }
      ],
      "description": "What a schedule does when an occurrence comes while its previous one is still waiting or\nrunning."
    },
    "Occurrence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "scheduleId": {
          "type": "string"
        },
        "scheduledAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The time it was due: when it was run by hand, for one that was."
        },
        "late": {
          "type": "boolean",
          "description": "It started more than a minute after it was due, as a catch-up does."
        },
        "manual": {
          "type": "boolean",
          "description": "Run by hand (`schedules/run`)."
        },
        "state": {
          "$ref": "#/$defs/OccurrenceState"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnState"
            },
            {
              "type": "null"
            }
          ],
          "description": "How its turn ended, once it's finished."
        },
        "why": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why it was skipped or failed, or what its turn's error said."
        },
        "threadId": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "endedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "scheduleId",
        "scheduledAt",
        "state",
        "recordedAt"
      ],
      "description": "One time a schedule came due, or was run by hand."
    },
    "OccurrenceState": {
      "oneOf": [
        {
          "type": "string",
          "const": "skipped",
          "description": "Not run, saying why."
        },
        {
          "type": "string",
          "const": "waiting",
          "description": "Written down for its Host, which hasn't taken it yet, as while it's unreachable."
        },
        {
          "type": "string",
          "const": "started",
          "description": "Its Host started its turn."
        },
        {
          "type": "string",
          "const": "finished",
          "description": "Its turn is over, as `outcome` says."
        },
        {
          "type": "string",
          "const": "failed",
          "description": "Its Host refused it, saying why."
        }
      ],
      "description": "How one occurrence of a schedule went."
    },
    "AddScheduleRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique among the Dispatcher's schedules."
        },
        "cron": {
          "type": [
            "string",
            "null"
          ],
          "description": "Absent for a one-off, which gives `at`."
        },
        "at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "A one-off's time, after now, in place of `cron`: it has one occurrence then, or a\ncatch-up after it as `missed` says, and is kept, done, with that occurrence."
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Dispatcher's own time zone when absent."
        },
        "host": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Host, by id or name; absent for a Bot's schedule."
        },
        "bot": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Bot each occurrence prompts, by id or name, in place of `host`, `agentId`, `cwd`,\n`policy`, `mode` and `thread`: the prompt goes into its current thread, or starts its\nfirst. Its `overlap` is `skip`."
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mode a new thread starts in; the agent's configured one when absent."
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The thread each occurrence prompts; each starts a new one when absent."
        },
        "missed": {
          "$ref": "#/$defs/Missed",
          "default": "latest"
        },
        "overlap": {
          "$ref": "#/$defs/Overlap",
          "default": "skip"
        }
      },
      "required": [
        "name",
        "prompt"
      ],
      "description": "`schedules/add`: a schedule with `cron`, or a one-off with `at` (feature `bots`), that names\neither a Host with `agentId`, `cwd` and `policy`, and maybe `mode` or `thread`, or a Bot\n(feature `bots`) in place of all of those. Invalid params, saying why, for both or neither of\neach pair."
    },
    "ScheduleResponse": {
      "type": "object",
      "properties": {
        "schedule": {
          "$ref": "#/$defs/Schedule"
        }
      },
      "required": [
        "schedule"
      ]
    },
    "RemoveScheduleRequest": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string"
        }
      },
      "required": [
        "schedule"
      ],
      "description": "`schedules/remove`: forget a schedule, by id or name, and its occurrences. One already\nstarted runs on."
    },
    "PauseScheduleRequest": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string"
        }
      },
      "required": [
        "schedule"
      ],
      "description": "`schedules/pause`: run nothing until resumed."
    },
    "ResumeScheduleRequest": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string"
        }
      },
      "required": [
        "schedule"
      ],
      "description": "`schedules/resume`: run again from now on, catching up nothing missed while paused, and\nforget its failures."
    },
    "RunScheduleRequest": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string"
        }
      },
      "required": [
        "schedule"
      ],
      "description": "`schedules/run`: run it now, as an occurrence of its own, paused or not."
    },
    "OccurrenceResponse": {
      "type": "object",
      "properties": {
        "occurrence": {
          "$ref": "#/$defs/Occurrence"
        }
      },
      "required": [
        "occurrence"
      ]
    },
    "ListOccurrencesRequest": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": [
            "string",
            "null"
          ],
          "description": "By id or name."
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "50 when absent."
        }
      },
      "description": "`occurrences/list`: the latest occurrences, of one schedule or all, newest first."
    },
    "ListOccurrencesResponse": {
      "type": "object",
      "properties": {
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Occurrence"
          }
        }
      },
      "required": [
        "occurrences"
      ]
    },
    "ListProjectsRequest": {
      "type": "object",
      "description": "`projects/list`: the Projects, by name."
    },
    "ListProjectsResponse": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Project"
          }
        }
      },
      "required": [
        "projects"
      ]
    },
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "`p-` and 20 hex digits."
        },
        "name": {
          "type": "string",
          "description": "What it's shown as and named by, with its id: unique among the Dispatcher's Projects,\nignoring case."
        },
        "kind": {
          "$ref": "#/$defs/ProjectKind"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "A git Project's repository's remote, as [`crate::worktrees::GitLocation::remote`] gives\nit, such as `github.com/owner/name`: a clone with it on another Host may join the\nProject. Absent for a repository without one, and for a directory."
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectLocation"
          },
          "description": "At most one for each Host, in the order they were added. Empty once every Host it was on\nhas been removed from the Dispatcher.",
          "default": []
        },
        "createdAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When it was renamed, or a location added or removed, last."
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "createdAt",
        "updatedAt"
      ],
      "description": "A named piece of the person's work (ADR 0031, WVE-189), with at most one location on each of\ntheir Hosts: a repository there, or a directory outside one. The Dispatcher keeps it, as the\nonly one of the person's programs that sees every Host; Hosts know nothing of it."
    },
    "ProjectKind": {
      "oneOf": [
        {
          "type": "string",
          "const": "git",
          "description": "A git repository on each Host, by its primary worktree, so all its worktrees are in\nthe Project."
        },
        {
          "type": "string",
          "const": "directory",
          "description": "A directory outside any repository, as given."
        }
      ],
      "description": "What a Project's locations are, fixed when it's made."
    },
    "ProjectLocation": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "description": "The Host, by its id; `hosts/list` gives its name."
        },
        "path": {
          "type": "string",
          "description": "Absolute on that Host's computer: a git Project's repository by its primary worktree."
        }
      },
      "required": [
        "hostId",
        "path"
      ],
      "description": "Where a Project is on one of the person's Hosts."
    },
    "GetProjectRequest": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "description": "`projects/get`: one Project, by id or name, ignoring case."
    },
    "ProjectResponse": {
      "type": "object",
      "properties": {
        "project": {
          "$ref": "#/$defs/Project"
        }
      },
      "required": [
        "project"
      ]
    },
    "AddProjectRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/NewLocation"
        }
      },
      "required": [
        "name",
        "location"
      ],
      "description": "`projects/add`: a new Project, of the kind its first location is. Invalid params, saying\nwhy, for an empty name, a name another Project has ignoring case, a Host that hasn't joined\nthe Dispatcher, a path that isn't absolute, or a location another Project has."
    },
    "NewLocation": {
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string",
          "description": "A Host that joined the Dispatcher, by its id."
        },
        "path": {
          "type": "string",
          "description": "Absolute on that Host's computer."
        },
        "kind": {
          "$ref": "#/$defs/ProjectKind"
        },
        "remote": {
          "type": [
            "string",
            "null"
          ],
          "description": "As [`crate::worktrees::GitLocation::remote`], for a repository that has one."
        }
      },
      "required": [
        "hostId",
        "path",
        "kind"
      ],
      "description": "A directory to make a location of a Project, as its Host's `worktrees/list` placed it: a\nrepository by its primary worktree, with the repository's remote, or a directory outside one,\nas given."
    },
    "UpdateProjectRequest": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "By id or name."
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its new name."
        },
        "removeHost": {
          "type": [
            "string",
            "null"
          ],
          "description": "Remove its location on this Host, by id or name."
        },
        "add": {
          "anyOf": [
            {
              "$ref": "#/$defs/NewLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Add this location."
        }
      },
      "required": [
        "project"
      ],
      "description": "`projects/update`: rename a Project, remove its location on one Host, and add one, in that\norder and all or none. A location added is refused when it's another kind than the\nProject's, a repository whose remote isn't the Project's, or on a Host where the Project\nhas a location still: one at the same path again changes nothing. A git Project without a\nremote takes the remote of a location added with one."
    },
    "RemoveProjectRequest": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        }
      },
      "required": [
        "project"
      ],
      "description": "`projects/remove`: forget a Project, by id or name, and all its locations. What's in its\ndirectories stays."
    },
    "ListBotsRequest": {
      "type": "object",
      "description": "`bots/list`: the Bots, by name."
    },
    "ListBotsResponse": {
      "type": "object",
      "properties": {
        "bots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Bot"
          }
        }
      },
      "required": [
        "bots"
      ]
    },
    "Bot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "`b-` and 20 hex digits."
        },
        "name": {
          "type": "string",
          "description": "What it's shown as and named by, with its id: unique among the Dispatcher's Bots,\nignoring case."
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its avatar's emoji (feature `bots_avatar`); absent until it's given one."
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/BotColor"
            },
            {
              "type": "null"
            }
          ],
          "description": "The colour its avatar is drawn on; absent until it's given one."
        },
        "agentId": {
          "type": "string"
        },
        "hostId": {
          "type": "string",
          "description": "The Host its threads run on, which it never leaves."
        },
        "hostName": {
          "type": "string",
          "description": "What the Dispatcher calls that Host now."
        },
        "connected": {
          "type": "boolean",
          "description": "Whether the Dispatcher is connected to its Host now."
        },
        "home": {
          "type": "string",
          "description": "Where its threads run and its memory files are, on its Host: absolute there, or under\nthe Host's home as `~/…`."
        },
        "policy": {
          "$ref": "#/$defs/PermissionPolicy",
          "description": "What its new threads answer permission requests by."
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
          "description": "The mode its new threads start in; the agent's configured one when absent."
        },
        "newThreadAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "A local time, `HH:MM` in `zone`, at which it starts a new thread each day, if its\nthread has had a turn since it started."
        },
        "zone": {
          "type": "string",
          "description": "An IANA time zone, such as `Africa/Johannesburg`."
        },
        "pauseAfter": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "How long, in milliseconds, a pending request in its thread may wait for the person\nbefore its schedules pause."
        },
        "thread": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its current thread; absent until the first prompt that reaches it starts one."
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BotThread"
          },
          "description": "Every thread it has had, oldest first, the current one last.",
          "default": []
        },
        "state": {
          "$ref": "#/$defs/BotState"
        },
        "waitingSince": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "Since when a pending request in its current thread has waited for the person, as the\nDispatcher saw it."
        },
        "paused": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why its schedules' occurrences are skipped, while they are: its thread has waited on\nthe person longer than `pause_after`. It resumes by itself once the thread no longer\nwaits."
        },
        "startingThread": {
          "type": "boolean",
          "description": "A new thread is being started: prompts for it wait, oldest first, to go into that one."
        },
        "createdAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When it was last changed with `bots/update`."
        },
        "createdBy": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Bot that made it, by id, when another Bot did (feature `bots_home`); absent for one\nthe person added."
        },
        "createdByName": {
          "type": [
            "string",
            "null"
          ],
          "description": "That Bot's name now; absent once it's gone."
        }
      },
      "required": [
        "id",
        "name",
        "agentId",
        "hostId",
        "hostName",
        "connected",
        "home",
        "policy",
        "zone",
        "pauseAfter",
        "state",
        "createdAt",
        "updatedAt"
      ],
      "description": "A named assistant the Dispatcher keeps (ADR 0028, WVE-118), whose work goes on in ordinary\nthreads, one at a time, on the one Host it names, in its home. Its prompts, from the person\nthrough the Dispatcher and from its schedules, go into its current thread; a new thread takes\nover when asked or daily, after the one before saves what it learned to the home. Its Host\nlearns nothing of it: its threads carry the labels `dispatcher` and `bot:<id>`."
    },
    "BotColor": {
      "type": "string",
      "enum": [
        "white",
        "brown",
        "red",
        "orange",
        "yellow",
        "green",
        "teal",
        "blue",
        "purple",
        "pink",
        "gray"
      ],
      "description": "The colours a Bot's avatar is drawn on (WVE-223), by name: each client draws them in its own\ntheme's."
    },
    "BotThread": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "startedAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "When its Host started it."
        },
        "endedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When a new thread took over from it; absent for the current one."
        }
      },
      "required": [
        "threadId",
        "startedAt"
      ],
      "description": "One of a Bot's threads."
    },
    "BotState": {
      "oneOf": [
        {
          "type": "string",
          "const": "working",
          "description": "Its thread runs a turn."
        },
        {
          "type": "string",
          "const": "needsYou",
          "description": "A pending request in its thread waits for the person."
        },
        {
          "type": "string",
          "const": "idle",
          "description": "Nothing runs: its thread is idle or not open, it has none yet, or the Dispatcher isn't\nconnected to its Host."
        }
      ],
      "description": "What a Bot's current thread is doing, as the Dispatcher last saw it on the Bot's Host."
    },
    "GetBotRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/get`: one Bot, by id or name, ignoring case; invalid params for none."
    },
    "BotResponse": {
      "type": "object",
      "properties": {
        "bot": {
          "$ref": "#/$defs/Bot"
        }
      },
      "required": [
        "bot"
      ]
    },
    "AddBotRequest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "description": "The Host, by id or name."
        },
        "agentId": {
          "type": "string"
        },
        "home": {
          "type": [
            "string",
            "null"
          ],
          "description": "Whole on the Host, or under its home as `~/…`; `~/bots/<name>` when absent, the name\nlowercased with a hyphen for each run of spaces or slash."
        },
        "job": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the Bot is for, in the person's words: its first `AGENTS.md` says so."
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionPolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "Approving nothing, so what isn't approved waits for the person, when absent."
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "newThreadAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "`HH:MM`: a new thread daily, then, in `zone`."
        },
        "zone": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Dispatcher's own time zone when absent."
        },
        "pauseAfter": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "[`DEFAULT_PAUSE_AFTER`] when absent."
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its avatar's emoji, checked as `bots/update` checks it."
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/BotColor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "host",
        "agentId"
      ],
      "description": "`bots/add`: a new Bot, with no thread yet: the first prompt that reaches it starts one in\nits home. Invalid params, saying why, for an empty name or one of more than one line, a name\nanother Bot has ignoring case, a Host that hasn't joined, an empty agent, a home that is\nneither whole nor under `~`, a time zone that doesn't parse, or a `newThreadAt` that isn't\n`HH:MM`.\n\nWith feature `bots_home` (WVE-178), once those pass the Dispatcher has the Bot's Host make\nthe home with `repos/init`: a git repository of its own, with the Bot's first memory files,\n`AGENTS.md` and `CLAUDE.md`, committed unless one of them is there already. The Bot is added\nonly once that's done, with the home as the Host gives it, whole, and the answer says what\nmaking it did. Refused with `host_unavailable` while the Host isn't connected, and as invalid\nparams when the Host is too old to make one or refuses, saying why; no Bot is added then."
    },
    "AddBotResponse": {
      "type": "object",
      "properties": {
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "home": {
          "anyOf": [
            {
              "$ref": "#/$defs/InitRepositoryResponse"
            },
            {
              "type": "null"
            }
          ],
          "description": "What making its home on its Host did; absent from a Dispatcher without `bots_home`."
        }
      },
      "required": [
        "bot"
      ]
    },
    "UpdateBotRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string",
          "description": "By id or name."
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "newThreadAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "zone": {
          "type": [
            "string",
            "null"
          ]
        },
        "pauseAfter": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "emoji": {
          "type": [
            "string",
            "null"
          ]
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/BotColor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/update`: change what's given, all or none, checked as `bots/add` checks it. A policy\nor mode applies to threads started from then on: an open thread keeps its own. `mode`,\n`newThreadAt`, `emoji` and `color` are cleared with `null`. An `emoji` (feature\n`bots_avatar`) is invalid params when it's empty, longer than [`MAX_BOT_EMOJI`] bytes, or has\na space, a letter or digit of ASCII, or a control character in it."
    },
    "RemoveBotRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/remove`: forget a Bot, by id or name, its schedules and the prompts still waiting for\nit. Its threads and its home stay on its Host."
    },
    "SendToBotRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        },
        "prompt": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentBlock"
          }
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "The sender's own name for this prompt, unique for the Bot."
        }
      },
      "required": [
        "bot",
        "prompt"
      ],
      "description": "`bots/send`: a prompt for a Bot, by id or name, from a sender that isn't attached to its\nthread, such as the CLI or a script. It's written down, as a delivery, and goes into the\nBot's current thread when first sent (queued there behind whatever runs), or starts its\nfirst thread; while a new thread is being started, it waits for that one. With `key`, the\nsame key again names the same delivery and sends nothing more."
    },
    "SentToBot": {
      "type": "object",
      "properties": {
        "deliveryId": {
          "type": "string",
          "description": "The delivery that carries the prompt, which its turn's origin names as its `id`."
        },
        "bot": {
          "$ref": "#/$defs/Bot",
          "description": "The Bot as it stands now: its current thread, if it has one yet, and whether a new\none is being started."
        }
      },
      "required": [
        "deliveryId",
        "bot"
      ]
    },
    "NewBotThreadRequest": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/newThread`: start a Bot's new thread, by id or name. Prompts for it wait from now on;\nonce its current thread is idle, that thread is asked to save what's worth keeping to the\nBot's memory files, note itself in `threads/` in the home and commit; then a new thread\nstarts in the home, the old one names it as its successor, and the prompts that waited go\ninto it. Invalid params, saying why, for a Bot with no thread yet or one starting one\nalready."
    },
    "WatchBotsRequest": {
      "type": "object",
      "description": "`bots/watch`: the Bots, as `bots/list` gives them; then a [`BotUpdatedNotification`]\nwhenever one is added or anything `bots/list` gives of it changes, and a\n[`BotRemovedNotification`] when one is removed, until the connection ends or the client\nsends `bots/unwatch` (feature `bots_watch`)."
    },
    "UnwatchBotsRequest": {
      "type": "object",
      "description": "`bots/unwatch`: stop what `bots/watch` sends."
    },
    "DevicePairedNotification": {
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/Device"
        }
      },
      "required": [
        "device"
      ],
      "description": "`devices/paired`: a device took the offer this connection made."
    },
    "BotUpdatedNotification": {
      "type": "object",
      "properties": {
        "bot": {
          "$ref": "#/$defs/Bot"
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/updated`, to clients watching the Bots: one was added, or changed, as it lists now."
    },
    "BotRemovedNotification": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        }
      },
      "required": [
        "bot"
      ],
      "description": "`bots/removed`, to clients watching the Bots: the Bot `bot`, by id, was removed, or its\nHost was."
    },
    "HostUnavailable": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/Reachability"
        },
        "why": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "why"
      ],
      "description": "Why the Dispatcher can't carry a connection to a Host: the `data` of the\n[`crate::errors::HOST_UNAVAILABLE`] that `hosts/open` answers, as `hosts/list` says it."
    },
    "TerminalStreamOpen": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/TerminalSize",
          "description": "The client's size, which is the terminal's once the client types."
        },
        "codec": {
          "type": "string",
          "description": "The Ghostty commit and snapshot format the client's libghostty-vt decodes, as\n`weave-holder --version` names its own."
        },
        "history": {
          "type": "boolean",
          "description": "With a VT restore, the history above the screen too, for a client whose terminal\nkeeps scrollback of its own, as `weave terminals attach` does. A holder from before\nit sends the screen alone."
        }
      },
      "required": [
        "ticket",
        "size",
        "codec"
      ],
      "description": "The client's first text frame."
    },
    "TerminalStreamOpened": {
      "type": "object",
      "properties": {
        "terminal": {
          "$ref": "#/$defs/HostTerminal"
        },
        "restore": {
          "$ref": "#/$defs/TerminalRestore"
        },
        "restoreBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "How many bytes of restore follow, in [`RESTORE`] frames, before the output does."
        }
      },
      "required": [
        "terminal",
        "restore",
        "restoreBytes"
      ],
      "description": "The Host's first text frame: the terminal as the restore has it, so a VT restore is drawn\nat its `size`, and how the restore that follows comes."
    },
    "TerminalRestore": {
      "oneOf": [
        {
          "type": "string",
          "const": "snapshot",
          "description": "A libghostty snapshot of the client's codec, history included."
        },
        {
          "type": "string",
          "const": "vt",
          "description": "The formatter's VT of the screen, without history, for a client of another codec."
        }
      ]
    },
    "TerminalStreamMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "updated": {
              "$ref": "#/$defs/HostTerminal"
            }
          },
          "required": [
            "updated"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "bell": {
              "type": "object"
            }
          },
          "required": [
            "bell"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "notification": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "body"
              ]
            }
          },
          "required": [
            "notification"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "progress": {
              "type": "object",
              "properties": {
                "state": {
                  "description": "`remove`, `set`, `error`, `indeterminate` or `pause`.",
                  "type": "string"
                },
                "progress": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "format": "uint8",
                  "minimum": 0,
                  "maximum": 255
                }
              },
              "required": [
                "state"
              ]
            }
          },
          "required": [
            "progress"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "clipboard": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text"
              ]
            }
          },
          "required": [
            "clipboard"
          ],
          "additionalProperties": false,
          "description": "To the device that last typed only."
        },
        {
          "type": "object",
          "properties": {
            "resync": {
              "type": "object",
              "properties": {
                "restore": {
                  "$ref": "#/$defs/TerminalRestore"
                },
                "restoreBytes": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "size": {
                  "$ref": "#/$defs/TerminalSize"
                }
              },
              "required": [
                "restore",
                "restoreBytes",
                "size"
              ]
            }
          },
          "required": [
            "resync"
          ],
          "additionalProperties": false,
          "description": "The client fell behind: a new restore of `restore_bytes` follows and replaces its\nscreen, a VT one drawn at `size`."
        },
        {
          "type": "object",
          "properties": {
            "resized": {
              "$ref": "#/$defs/TerminalSize"
            }
          },
          "required": [
            "resized"
          ],
          "additionalProperties": false,
          "description": "The terminal took a new size here, in order with the output, so the client's screen\ntakes it at the same point as the owner's."
        },
        {
          "type": "object",
          "properties": {
            "exited": {
              "type": "object",
              "properties": {
                "exitCode": {
                  "type": "integer",
                  "format": "int32"
                }
              },
              "required": [
                "exitCode"
              ]
            }
          },
          "required": [
            "exited"
          ],
          "additionalProperties": false,
          "description": "The program ended; the Host closes the stream after it."
        }
      ],
      "description": "The Host's later text frames."
    },
    "TerminalStreamClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resize": {
              "$ref": "#/$defs/TerminalSize"
            }
          },
          "required": [
            "resize"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "resync": {
              "type": "object"
            }
          },
          "required": [
            "resync"
          ],
          "additionalProperties": false,
          "description": "A fresh restore, in a [`Message::Resync`], for a client that stopped drawing for a\nwhile: one whose terminal another device sized. A holder from before it sends none."
        }
      ],
      "description": "The client's text frames after [`Open`]."
    }
  }
}
