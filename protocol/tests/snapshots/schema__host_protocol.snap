      "description": "JSON-RPC error object.\n\nRepresents an error that occurred during method execution, following the\nJSON-RPC 2.0 error object specification with optional additional data.\n\nSee protocol docs: [JSON-RPC Error Object](https://www.jsonrpc.org/specification#error_object)"
    },
    "ErrorCode": {
      "anyOf": [
        {
          "type": "integer",
          "const": -32700,
          "description": "**Parse error**: Invalid JSON was received by the server.\nAn error occurred on the server while parsing the JSON text.",
          "title": "Parse error",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32600,
          "description": "**Invalid request**: The JSON sent is not a valid Request object.",
          "title": "Invalid request",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32601,
          "description": "**Method not found**: The method does not exist or is not available.",
          "title": "Method not found",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32602,
          "description": "**Invalid params**: Invalid method parameter(s).",
          "title": "Invalid params",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32603,
          "description": "**Internal error**: Internal JSON-RPC error.",
          "title": "Internal error",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32800,
          "description": "**Request cancelled**: Execution of the method was aborted either due to a cancellation request from the caller or\nbecause of resource constraints or shutdown.",
          "title": "Request cancelled",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32000,
          "description": "**Authentication required**: Authentication is required before this operation can be performed.",
          "title": "Authentication required",
          "format": "int32"
        },
        {
          "type": "integer",
          "const": -32002,
          "description": "**Resource not found**: A given resource, such as a session or file, was not found.",
          "title": "Resource not found",
          "format": "int32"
        },
        {
          "type": "integer",
          "format": "int32",
          "description": "Other undefined error code."
        }
      ],
      "description": "Predefined error codes for common JSON-RPC and ACP-specific errors.\n\nStandard errors use the JSON-RPC 2.0 codes. ACP-specific errors use the JSON-RPC\nserver-error range (-32000 to -32099), and request cancellation uses -32800 from the\nrange LSP reserves (-32899 to -32800)."
    },
    "WatchThreadsRequest": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "`threads/watch`: the Host's threads as `threads/list` gives them without an agent, then a\n[`ThreadUpdatedNotification`] or [`ThreadRemovedNotification`] for every change, until the\nconnection ends or the client sends `threads/unwatch`. Blank threads never appear. With\n`labels` (feature `labels`), only the threads that carry every one of them: a change that\nmakes one stop matching is the last the watcher hears of it, as an update showing its labels."
    },
    "WatchThreadsResponse": {
      "type": "object",
      "properties": {
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThreadListing"
          }
        }
      },
      "required": [
        "threads"
      ]
    },
    "UnwatchThreadsRequest": {
      "type": "object",
      "description": "`threads/unwatch`: stop what `threads/watch` sends."
    },
    "CreateThreadRequest": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "additionalDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "type": [
            "string",
            "null"
          ],
