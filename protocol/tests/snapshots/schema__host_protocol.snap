          "$ref": "#/$defs/ProgramState"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockedKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255,
          "description": "0 to 100."
        },
        "app": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "msg": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state"
      ],
      "description": "An OSC 7501 record, with `title` and `msg` decoded."
    },
    "ProgramState": {
      "type": "string",
      "enum": [
        "idle",
        "working",
        "done",
        "blocked",
        "error"
      ]
    },
    "BlockedKind": {
      "type": "string",
      "enum": [
        "permission",
        "question",
        "auth"
      ]
    },
    "WatchTerminalsRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "description": "`terminals/watch`: a scope's terminals as `terminals/list` gives them, then a\n[`TerminalUpdatedNotification`] or [`TerminalRemovedNotification`] for every change in that\nscope, until the connection ends or the client sends `terminals/unwatch`."
    },
    "UnwatchTerminalsRequest": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "description": "`terminals/unwatch`: stop what `terminals/watch` sends for `scope`."
    },
    "NewTerminalRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "openedFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "A command and its arguments, run under a login shell instead of an interactive one."
        },
        "size": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalSize"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its first size; 80×24 when absent. The first client to attach usually sets it again."
        }
      },
      "required": [
        "directory"
      ],
      "description": "`terminals/new`: a terminal in `directory`, belonging to its scope. A holder starts the\nperson's login shell there, or runs `command` under it, as Ghostty starts a shell."
    },
    "TerminalResponse": {
      "type": "object",
      "properties": {
        "terminal": {
          "$ref": "#/$defs/HostTerminal"
        }
      },
      "required": [
        "terminal"
      ]
    },
    "CloseTerminalRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "description": "`terminals/close`: hang up the terminal's program, which ends it."
    },
    "SetTerminalLabelRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "description": "`terminals/setLabel`: name the terminal, or clear its name."
    },
    "WriteTerminalRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "description": "`terminals/write`: text as if typed, for clients that don't attach. `\\r` is Enter."
    },
    "FormatTerminalRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "format": {
          "$ref": "#/$defs/TerminalFormat",
          "default": "text"
        },
        "history": {
          "type": "boolean",
          "description": "The history above the screen too."
        },
        "trim": {
          "type": "boolean",
          "description": "Trailing whitespace and blank lines trimmed."
        }
      },
      "required": [
        "id"
      ],
      "description": "`terminals/format`: the terminal's visible screen through the formatter, or with its history."
    },
    "TerminalFormat": {
      "oneOf": [
        {
          "type": "string",
          "const": "text",
          "description": "The characters alone."
        },
        {
          "type": "string",
          "const": "vt",
          "description": "VT sequences with styles, cursor, modes and palette, which a terminal restores from."
        }
      ]
    },
    "FormatTerminalResponse": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        }
      },
      "required": [
        "content"
      ]
    },
    "AttachTerminalRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "description": "`terminals/attach`: a ticket for the terminal's stream, good once, for\n[`stream::TICKET_LIFETIME_MS`], to the device that asked."
    },
    "AttachTerminalResponse": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "expiresAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "ticket",
        "expiresAt"
      ]
    },
    "ListSessionsRequest": {
      "type": "object",
      "description": "`sessions/list`: the Host's Sessions, by directory, without their layouts."
    },
    "ListSessionsResponse": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostSession"
          }
        }
      },
      "required": [
        "sessions"
      ]
    },
    "HostSession": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "description": "What it's known by: a worktree, or a directory outside a repository; symlinks resolved."
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "Its layout's revision: 0 before any client set one, then one more with every write."
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionLayout"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its layout, as the last client to set it wrote it; absent before any did, and in\n`sessions/list`. The Host never reads it: [`layout::Layout`] is the shape clients agree\non."
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitLocation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where in a git repository it is; absent outside one."
        },
        "createdAt": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updatedAt": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "When its layout was last set; absent before any client set one."
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          },
          "description": "Its threads that the Host has a record of, open or not, most recently active first, so a\nclient can place one no Block shows: those clients added to it and those its threads\nstarted, not every thread in its directory. One a client added before prompting it is\nhere too, though no listing has it yet. `threads/watch` follows them.",
          "default": []
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Its terminals' ids, oldest first: those clients added to it and those opened from its\nthreads. `terminals/watch` follows them.",
          "default": []
        }
      },
      "required": [
        "directory",
        "revision",
        "createdAt"
      ],
      "description": "A Session as clients see it. `HostSession` in the schema, apart from ACP's sessions."
    },
    "SessionLayout": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "The shape it was written in: [`VERSION`]."
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionTab"
          },
          "description": "In order. Which is in front is each device's own."
        }
      },
      "required": [
        "version",
        "tabs"
      ],
      "description": "A Session's tabs."
    },
    "SessionTab": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Permanent and opaque, unique in the layout."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "The person's name for it; clients name an untitled tab from what it shows."
        },
        "root": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionNode"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its tree of docked Blocks; absent for a tab with none."
        },
        "floating": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionFloating"
          },
          "description": "Blocks over the tree, last on top."
        }
      },
      "required": [
        "id"
      ]
    },
    "SessionNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/SessionSplit",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "row"
            }
          },
          "required": [
            "kind"
          ],
          "description": "Side by side, left to right."
        },
        {
          "$ref": "#/$defs/SessionSplit",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "column"
            }
          },
          "required": [
            "kind"
          ],
          "description": "One above another, top to bottom."
        },
        {
          "$ref": "#/$defs/SessionBlock",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "block"
            }
          },
          "required": [
            "kind"
          ]
        }
      ],
      "description": "A docked Block, or several side by side or one above another."
    },
    "SessionSplit": {
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionNode"
          }
        },
        "sizes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "description": "Each child's share of the space, in the children's order, relative to the others';\nequal shares when absent."
        }
      },
      "required": [
        "children"
      ]
    },
    "SessionBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Permanent and opaque, unique in the layout."
        },
        "type": {
          "type": "string",
          "description": "A reverse-DNS name, such as `weave.thread` (`props.threadId`) or `weave.terminal`\n(`props.terminalId`). A client without the type shows the type and props as text."
        },
        "props": {
          "type": "object",
          "additionalProperties": true,
          "description": "What the type needs, as it defines."
        }
      },
      "required": [
        "id",
        "type"
      ],
      "description": "What one place in a tab shows. It points at something on the Session's Host, such as a thread or a\nterminal, which the Host doesn't read. A client that closes one closes what it shows: a\nthread, which can be shown again, or a terminal, which ends with its Block (ADR 0031)."
    },
    "SessionFloating": {
      "type": "object",
      "properties": {
        "block": {
          "$ref": "#/$defs/SessionBlock"
        },
        "frame": {
          "$ref": "#/$defs/SessionFrame",
          "description": "Where it is while it isn't minimized, and where it comes back to."
        },
        "minimized": {
          "type": "boolean",
          "description": "Put away: clients show it as its name, to bring back, in place of its frame."
        }
      },
      "required": [
        "block",
        "frame"
      ],
      "description": "A Block over a tab's tree."
    },
    "SessionFrame": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "number",
          "format": "double"
        },
        "height": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "description": "Where a floating Block is, as fractions of its tab's width and height from its top left."
    },
    "GetSessionRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "description": "Any directory: its Session is that of the deepest worktree it's in, or of the directory\nitself outside a repository."
        }
      },
      "required": [
        "directory"
      ],
      "description": "`sessions/get`: the Session `directory` is in, with its layout. `no_session` when it has\nnone."
    },
    "SessionResponse": {
      "type": "object",
      "properties": {
        "session": {
          "$ref": "#/$defs/HostSession"
        }
      },
      "required": [
        "session"
      ]
    },
    "SetSessionRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/SessionLayout"
        },
        "ifRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0,
          "description": "The revision the client's layout was made from: 0 for a Session without one yet."
        }
      },
      "required": [
        "directory",
        "layout"
      ],
      "description": "`sessions/set`: a new layout for the Session `directory` is in, made first if it has none.\nThe newest write wins: the layout replaces whatever was there, under the next revision, and\nevery client watching the Session is sent it. With `ifRevision`, only when that is still\nthe Session's revision, else `revision_conflict` with the current one, so a client can merge\nrather than overwrite. Refused, as invalid params, over [`MAX_LAYOUT`] bytes."
    },
    "WatchSessionsRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "`sessions/watch`: the Session `directory` is in, or with no `directory` every Session, as\n`sessions/get` gives them; then a [`SessionUpdatedNotification`] when one is made, its\nlayout is set or something joins it, and a [`SessionEndedNotification`] when one ends, until the connection ends\nor the client sends `sessions/unwatch`. A directory with no Session yet may be watched, and\nanswers no Session."
    },
    "WatchSessionsResponse": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "description": "The directory watched, as the Host resolved it; absent when watching every Session."
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostSession"
          },
          "description": "With their layouts."
        }
      },
      "required": [
        "sessions"
      ]
    },
    "UnwatchSessionsRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "`sessions/unwatch`: stop what `sessions/watch` sends for `directory`, as its answer gave it,\nor for every Session without one."
    },
    "EndSessionRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "description": "`sessions/end`: end the Session `directory` is in, for good. Its open threads close, as\n`thread/close` closes them, its terminals end, and its layout is forgotten: nothing brings it\nback. What else is in its directory, which was never the Session's, is left as it is. Its\ndirectory stays, a worktree too. Refused, with nothing closed, while a thread in it runs a\nturn or waits on a request, or a terminal in it runs a command (`session_busy`); `no_session`\nwhen it has none."
    },
    "AddToSessionRequest": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        },
        "threads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SessionId"
          }
        },
        "terminals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "directory"
      ],
      "description": "`sessions/add`: `threads` and `terminals` are the Session's that `directory` is in from now\non, which is made first if the directory has none, without a layout. A client asks it as it\nstarts a thread or terminal in a Session, and to bring in one started elsewhere. Each must be\nin the Session's directory, else invalid params; one that's already its changes nothing.\nEvery client watching the Session is sent it."
    },
    "ReportThreadRequest": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId"
        },
        "about": {
          "$ref": "#/$defs/OtherThread",
          "description": "The thread the report is on."
        },
        "text": {
          "type": "string"
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "description": "Makes it safe to send again (feature `requestKeys`)."
        }
      },
      "required": [
        "threadId",
        "about",
        "text"
      ],
      "description": "`thread/report` (feature `otherHosts`), a service's only: tell a thread how a turn its\nagent began on another Host went, or that it waits on a person there, as the Host tells it\nof its own threads' turns (ADR 0023): into its running turn if its agent takes steers,\notherwise through its queue, in the last of its successors, taking it up again if it isn't\nopen. The turn or steer it makes is a report on `about`, which nobody hears the end of."
    },
    "DeclareToolsRequest": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tool"
          }
        },
        "hosts": {
          "type": "boolean",
          "description": "The service reaches the person's other Hosts (feature `otherHosts`, ADR 0029): the Host\nsends it the Host tool calls that name another Host, as `service/hostCall`, until\nanother service says so too. Kept with its tools."
        }
      },
      "required": [
        "tools"
      ],
      "description": "`service/declareTools`: the tools a service serves, replacing those it declared before\n(feature `serviceTools`). The Host keeps them, across the service's reconnects and its own\nrestarts, and offers them to the agent of every thread set up from then on, as\n`<service>__<tool>`; a thread already open keeps the tools it started with. Only a service\nmay declare tools. Each name is letters, digits, `_` and `-`, and the names agents see may\nbe no longer than [`MAX_SERVICE_TOOL_NAME`] nor another service's. Answered with those names."
    },
    "Tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "inputSchema": true
      },
      "required": [
        "name",
        "title",
        "description",
        "inputSchema"
      ],
      "description": "A tool in one of the Host's catalogs, as agents see it in `tools/list`."
    },
    "DeclareToolsResponse": {
      "type": "object",
      "properties": {
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The tools' names as agents see them, in order."
        }
      },
      "required": [
        "names"
      ]
    },
    "AnswerToolRequest": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ClientToolResult"
        }
      },
      "required": [
        "callId",
        "result"
      ],
      "description": "`service/answerTool`: the result of a call made to this service, which only it may answer,\nonce."
    },
    "ThreadEventNotification": {
      "type": "object",
      "properties": {
        "threadId": {
          "$ref": "#/$defs/SessionId",
          "description": "The attached thread, the root of any subagent thread the event is about."
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "The event's position in the thread's journal."
        },
        "at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "event": {
          "$ref": "#/$defs/ThreadEvent"
        }
      },
      "required": [
        "threadId",
        "seq",
        "at",
        "event"
      ],
      "description": "`thread/event`: one journaled event, in order."
    },
    "ThreadEvent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "notification": {
              "$ref": "#/$defs/SessionNotification"
            },
            "kind": {
              "type": "string",
              "const": "update"
            }
          },
          "required": [
            "kind",
            "notification"
          ],
          "description": "The agent's `session/update`, for this thread or a subagent thread; or a client's\nmode or config option change, which reaches the others this way."
        },
        {
          "type": "object",
          "properties": {
            "threadId": {
              "$ref": "#/$defs/SessionId"
            },
            "prompt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContentBlock"
              }
            },
            "origin": {
              "$ref": "#/$defs/TurnOrigin"
            },
            "queuedId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The queued prompt it started from, which has left the queue."
            },
            "turnId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The turn's id (feature `turnIds`): its `queuedId` when it has one."
            },
            "continues": {
              "type": [
                "string",
                "null"
              ],
              "description": "The interrupted turn it continues, which a Host that stopped under it left\n(WVE-144)."
            },
            "kind": {
              "type": "string",
              "const": "turnStarted"
            }
          },
          "required": [
            "kind",
            "threadId",
            "prompt",
            "origin"
          ],
          "description": "A turn started, with its prompt."
        },
        {
          "type": "object",
          "properties": {
            "threadId": {
              "$ref": "#/$defs/SessionId"
            },
            "prompt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContentBlock"
              }
            },
            "origin": {
              "$ref": "#/$defs/TurnOrigin"
            },
            "kind": {
              "type": "string",
              "const": "turnSteered"
            }
          },
