---
source: protocol/tests/wire.rs
expression: round_trip(&host_catalog())
---
[
  {
    "name": "rename_session",
    "title": "Rename this thread",
    "description": "Give this thread a new title: the name people see for it in their weave thread lists, on every device. Use it when the person asks for a name, or when the work has moved on and the title misleads. Keep it short and specific. It doesn't change the title you keep yourself.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The new title, up to 200 characters.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_sessions",
    "title": "List threads",
    "description": "List the threads of the weave Host this thread runs in, across agents and directories, most recently active first: each one's id, agent, directory, title, whether it is open and running, and which thread started it. Answers with the Host's sessions/list result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "description": "Only this agent's threads, such as claude or codex, with the agent's own history of the directory."
        },
        "cwd": {
          "type": "string",
          "description": "Only threads in this absolute directory."
        },
        "repo": {
          "type": "string",
          "description": "Only threads in this git repository's worktrees, given by any directory in it. Not with agentId."
        },
        "activity": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "waiting"
          ],
          "description": "Only the open threads doing this: idle, running a turn, or waiting on a person. Not with agentId."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "list_agents",
    "title": "List agents",
    "description": "List the agents the weave Host can start threads with: each one's id, name, and what it's for when its configuration says, and which is the default. Use it to choose an agent for start_session. Answers with the Host's agents/list result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "read_session",
    "title": "Read a thread",
    "description": "Read one thread of the weave Host: how it lists, and its latest turn, or the one turnId names: the prompt, its state (queued, running, waiting on a person, or how it ended), and the agent's last message in it. Use it to read the full answer of a thread you prompted, or any other thread. Answers with the Host's sessions/get result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The thread's id, as list_sessions or start_session gave it."
        },
        "turnId": {
          "type": "string",
          "description": "Optional: a turn of the thread, as prompt_session (its queuedId) or start_session gave it."
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "start_session",
    "title": "Start a thread with another agent",
    "description": "Hand work to another agent: start a thread with it in the weave Host and send it a prompt. It works on its own, in a thread people can watch and answer from their weave clients. This answers once its turn has started; when the turn ends, you'll get a message saying how it ended, with the start of the agent's answer, so don't wait or poll for it. It can approve only the tool kinds your own thread approves. Give sessionId to prompt an existing thread instead of a new one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "agentId": {
          "type": "string",
          "description": "The agent to start; list_agents says which there are and what each is for."
        },
        "prompt": {
          "type": "string",
          "description": "What to ask of it: everything it needs to know, since it doesn't see this conversation."
        },
        "cwd": {
          "type": "string",
          "description": "The absolute directory it works in; yours when absent."
        },
        "sessionId": {
          "type": "string",
          "description": "An existing thread, to prompt instead of starting one."
        },
        "approve": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "edit",
              "delete",
              "move",
              "search",
              "execute",
              "think",
              "fetch",
              "switch_mode",
              "other"
            ]
          },
          "description": "Tool kinds it may use without asking anyone; yours when absent, and never more than yours."
        },
        "otherwise": {
          "type": "string",
          "enum": [
            "ask",
            "reject"
          ],
          "description": "What happens to tool calls it doesn't approve: ask the people attached, or reject them. Yours when absent; it rejects if you do."
        },
        "key": {
          "type": "string",
          "description": "Optional: a name of your choosing, such as a UUID, so that calling again with the same key after a failure starts nothing twice.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "agentId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "prompt_session",
    "title": "Prompt a thread",
    "description": "Send a prompt to any open thread of the weave Host, one you started or another: it starts a turn at once if none runs, or waits in the thread's queue for the running one to end. When the turn ends, you'll get a message saying how it ended. Its answer's queuedId names the turn, for read_session.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The thread's id, as list_sessions or start_session gave it."
        },
        "prompt": {
          "type": "string",
          "description": "What to ask of it."
        },
        "key": {
          "type": "string",
          "description": "Optional: a name of your choosing, such as a UUID, so that calling again with the same key after a failure starts nothing twice.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "sessionId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "steer_session",
    "title": "Steer a thread",
    "description": "Send a message into the running turn of any thread of the weave Host, to correct or add to what it's doing, without starting another turn. If no turn runs, nothing is sent: use prompt_session instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The thread's id, as list_sessions or start_session gave it."
        },
        "prompt": {
          "type": "string",
          "description": "The message for its turn."
        }
      },
      "required": [
        "sessionId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_session_turn",
    "title": "Cancel a thread's turn",
    "description": "Stop the running turn of any thread of the weave Host. The thread stays, and can be prompted again.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "The thread's id, as list_sessions or start_session gave it."
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false
    }
  }
]
