---
source: protocol/tests/wire.rs
expression: round_trip(&host_catalog())
---
[
  {
    "name": "rename_thread",
    "title": "Rename this thread",
    "description": "Give this thread a new title: the name people see for it in their weave thread lists, on every device. Use it when the person asks for a name, or when the work has moved on and the title misleads. Keep it short and specific. It doesn't change the title you keep yourself.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "The new title, up to 200 characters.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "list_hosts",
    "title": "List the person's other Hosts",
    "description": "List the person's other weave Hosts, usually other computers, which this thread's Host reaches through the person's Dispatcher: each one's id and name, whether the Dispatcher is connected to it now, and if not, why: refused (it revoked the Dispatcher), down (its computer answered but its weave Host didn't), unreachable (nothing answered), or otherHost. The other tools take one as host, to list, read, start and prompt threads there. Pairing Hosts with the Dispatcher is the person's to do. Answers with this Host's id and the Hosts as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_projects",
    "title": "List the person's Projects",
    "description": "List the person's Projects: named pieces of their work, each a git repository or a directory, with at most one location on each of their weave Hosts, at whatever path it has there. Each has its id, name, kind (git or directory), its repository's remote, and its locations: a Host's id and the path there; hosts gives every Host's name. start_thread and list_threads take one as project, to work in it on a Host that has it without knowing its path there. Making and changing Projects is the person's to do, with `weave projects`. Answers with this Host's id, the Projects and the Hosts as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "list_threads",
    "title": "List threads",
    "description": "List the threads of the weave Host this thread runs in, across agents and directories, most recently active first: each one's id, agent, directory, title, whether it is open and running, and which thread started it. Answers with the Host's threads/list result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "project": {
          "type": "string",
          "description": "Optional: one of the person's Projects, by the name or id list_projects gives, to list only the threads in it on the Host listed: none where it has no location. Not with cwd or repo."
        },
        "agentId": {
          "type": "string",
          "description": "Only this agent's threads, such as claude or codex, with the agent's own history of the directory."
        },
        "cwd": {
          "type": "string",
          "description": "Only threads in this absolute directory."
        },
        "repo": {
          "type": "string",
          "description": "Only threads in this git repository's worktrees, given by any directory in it. Not with agentId."
        },
        "activity": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "waiting"
          ],
          "description": "Only the open threads doing this: idle, running a turn, or waiting on a person. Not with agentId."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "list_agents",
    "title": "List agents",
    "description": "List the agents the weave Host can start threads with: each one's id, name, and what it's for when its configuration says, and which is the default. Use it to choose an agent for start_thread. Answers with the Host's agents/list result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "read_thread",
    "title": "Read a thread",
    "description": "Read one thread of the weave Host: how it lists, and its latest turn, or the one turnId names: the prompt, its state (queued, running, waiting on a person, or how it ended), and the agent's last message in it. Use it to read the full answer of a thread you prompted, or any other thread. Answers with the Host's threads/get result as JSON.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "threadId": {
          "type": "string",
          "description": "The thread's id, as list_threads or start_thread gave it."
        },
        "turnId": {
          "type": "string",
          "description": "Optional: a turn of the thread, as prompt_thread (its queuedId) or start_thread gave it."
        }
      },
      "required": [
        "threadId"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "start_thread",
    "title": "Start a thread with another agent",
    "description": "Hand work to another agent: start a thread with it in the weave Host and send it a prompt. It works on its own, in a thread people can watch and answer from their weave clients. This answers once its turn has started; when the turn ends, you'll get a message saying how it ended, with the start of the agent's answer, so don't wait or poll for it. It can approve only the tool kinds your own thread approves. Give threadId to prompt an existing thread instead of a new one.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "agentId": {
          "type": "string",
          "description": "The agent to start; list_agents says which there are and what each is for."
        },
        "prompt": {
          "type": "string",
          "description": "What to ask of it: everything it needs to know, since it doesn't see this conversation."
        },
        "project": {
          "type": "string",
          "description": "Optional: one of the person's Projects, by the name or id list_projects gives, to work in its location on the Host it starts on, which has to have one: in a git Project, the repository's main checkout."
        },
        "cwd": {
          "type": "string",
          "description": "The absolute directory it works in, or one under the home of its Host as ~/…; yours when absent. With project, a directory inside the Project relative to it instead, such as app. With host and neither: when your directory is in a Project, the Project's location there, in the same subdirectory; otherwise the same directory under the home there, which has to be a checkout of the same repository: its main checkout when yours is another worktree, since your branch may not be there."
        },
        "threadId": {
          "type": "string",
          "description": "An existing thread, to prompt instead of starting one."
        },
        "approve": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "read",
              "edit",
              "delete",
              "move",
              "search",
              "execute",
              "think",
              "fetch",
              "switch_mode",
              "other"
            ]
          },
          "description": "Tool kinds it may use without asking anyone; yours when absent, and never more than yours."
        },
        "otherwise": {
          "type": "string",
          "enum": [
            "ask",
            "reject"
          ],
          "description": "What happens to tool calls it doesn't approve: ask the people attached, or reject them. Yours when absent; it rejects if you do."
        },
        "key": {
          "type": "string",
          "description": "Optional: a name of your choosing, such as a UUID, so that calling again with the same key after a failure starts nothing twice.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "agentId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "prompt_thread",
    "title": "Prompt a thread",
    "description": "Send a prompt to any open thread of the weave Host, one you started or another: it starts a turn at once if none runs, or waits in the thread's queue for the running one to end. When the turn ends, you'll get a message saying how it ended. Its answer's queuedId names the turn, for read_thread.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "threadId": {
          "type": "string",
          "description": "The thread's id, as list_threads or start_thread gave it."
        },
        "prompt": {
          "type": "string",
          "description": "What to ask of it."
        },
        "key": {
          "type": "string",
          "description": "Optional: a name of your choosing, such as a UUID, so that calling again with the same key after a failure starts nothing twice.",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "steer_thread",
    "title": "Steer a thread",
    "description": "Send a message into the running turn of any thread of the weave Host, to correct or add to what it's doing, without starting another turn. If no turn runs, nothing is sent: use prompt_thread instead.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "threadId": {
          "type": "string",
          "description": "The thread's id, as list_threads or start_thread gave it."
        },
        "prompt": {
          "type": "string",
          "description": "The message for its turn."
        }
      },
      "required": [
        "threadId",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "cancel_thread_turn",
    "title": "Cancel a thread's turn",
    "description": "Stop the running turn of any thread of the weave Host. The thread stays, and can be prompted again.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "description": "Optional: another of the person's weave Hosts, by the id or name list_hosts gives, to act there instead of on this thread's Host."
        },
        "threadId": {
          "type": "string",
          "description": "The thread's id, as list_threads or start_thread gave it."
        }
      },
      "required": [
        "threadId"
      ],
      "additionalProperties": false
    }
  }
]
