---
source: protocol/tests/wire.rs
expression: "message(&ToolCallNotification\n{\n    call_id: \"c-1\".to_owned(), tool: \"add_schedule\".to_owned(), arguments,\n    caller: ToolCaller\n    {\n        thread_id: \"s-1\".into(), agent_id: \"claude\".to_owned(), cwd:\n        \"/repo\".into(), policy: PermissionPolicy::headless(Vec::new()),\n        labels: vec![\"bot:daily\".to_owned()],\n    },\n})"
---
{
  "method": "service/toolCall",
  "params": {
    "callId": "c-1",
    "tool": "add_schedule",
    "arguments": {
      "cron": "0 9 * * *"
    },
    "caller": {
      "threadId": "s-1",
      "agentId": "claude",
      "cwd": "/repo",
      "policy": {
        "otherwise": "reject"
      },
      "labels": [
        "bot:daily"
      ]
    }
  }
}
