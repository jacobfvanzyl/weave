# Local deploy-control configuration. Copy to server/.env.deploy and chmod 600.
# This file controls Dokploy; it is not injected into the Weave server container.
WEAVE_DOKPLOY_URL=http://bazzite:3000
WEAVE_DOKPLOY_COMPOSE_ID=replace-with-compose-id
WEAVE_DOKPLOY_API_TOKEN=replace-with-api-token
WEAVE_DOKPLOY_SSH_TARGET=root@bazzite

# Stable tailnet endpoints used for post-deploy health checks and Garage cutover.
WEAVE_REMOTE_SERVER_URL=http://bazzite:4111
WEAVE_REMOTE_OBJECT_STORAGE_ENDPOINT=http://bazzite:3900
# Owner credential used only for the authenticated post-deploy RPC initialize probe.
WEAVE_REMOTE_OWNER_TOKEN=replace-with-owner-token

# Optional overrides.
# WEAVE_DOKPLOY_TIMEOUT_MS=900000
# WEAVE_LOCAL_POSTGRES_CONTAINER=weave-dbos-postgres
# WEAVE_DEPLOY_REMOTE=origin
# WEAVE_DEPLOY_REF=refs/heads/deploy/pi-dev
# WEAVE_LAST_GOOD_REF=refs/heads/deploy/pi-last-good
