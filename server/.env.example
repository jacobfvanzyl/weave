OPENAI_API_KEY=your-api-key
EXA_API_KEY=your-exa-api-key

# Canonical persistence. Weave, Mastra, and DBOS share this physical Postgres database.
# DBOS_SYSTEM_DATABASE_URL defaults to WEAVE_DATABASE_URL when WEAVE_DBOS_ENABLED=1.
WEAVE_DATABASE_URL=postgres://supabase_admin:weave@127.0.0.1:54329/weave
WEAVE_POSTGRES_PORT=54329
WEAVE_POSTGRES_PASSWORD=weave
# Set this to the existing Docker volume name when moving a local manual
# Postgres container under docker compose.
# WEAVE_POSTGRES_VOLUME=weave-postgres
# WEAVE_DBOS_ENABLED=1
# DBOS_SYSTEM_DATABASE_URL=postgres://supabase_admin:weave@127.0.0.1:54329/weave

# S3-compatible object storage. The Docker stack uses Garage.
# Garage default access key identifiers must be at least 8 characters.
WEAVE_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:3900
WEAVE_OBJECT_STORAGE_REGION=garage
WEAVE_OBJECT_STORAGE_BUCKET=weave
WEAVE_OBJECT_STORAGE_ACCESS_KEY=replace-with-local-garage-access-key
WEAVE_OBJECT_STORAGE_SECRET_KEY=replace-with-local-garage-secret-key
WEAVE_OBJECT_STORAGE_FORCE_PATH_STYLE=1
# GARAGE_RPC_SECRET=replace-with-local-garage-rpc-secret
# WEAVE_GARAGE_META_VOLUME=weave-garage-meta
# WEAVE_GARAGE_DATA_VOLUME=weave-garage-data

# Semantic recall defaults to local Ollama embeddings:
#   deno task infra:up
#   deno task infra:ollama:pull
#   WEAVE_MEMORY_EMBEDDING_MODEL=ollama/nomic-embed-text
#   WEAVE_MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#
# To use hosted OpenAI embeddings instead:
# WEAVE_MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENAI_API_KEY=your-api-key
#
# Set this if your Ollama task binds a different host port.
# WEAVE_OLLAMA_PORT=11434
# WEAVE_OLLAMA_VOLUME=weave-ollama
# WEAVE_OLLAMA_IMAGE=ollama/ollama:latest
# WEAVE_OLLAMA_MODEL=nomic-embed-text
# WEAVE_SEMANTIC_RECALL=false

# Observational memory defaults to the ChatGPT subscription gateway.
# WEAVE_OBSERVATIONAL_MEMORY_MODEL=chatgpt/codex/gpt-5.4-mini
# WEAVE_OBSERVATIONAL_MEMORY=false

# Required single-owner auth. Vite clients still receive WEAVE_AUTH_TOKEN as
# their injected bearer token, but the server's canonical env is WEAVE_OWNER_*.
WEAVE_OWNER_TOKEN=replace-with-local-dev-token
WEAVE_OWNER_ID=local-user
WEAVE_OWNER_NAME=Local User

# Compatibility aliases accepted during migration:
# WEAVE_AUTH_TOKEN=replace-with-local-dev-token
# WEAVE_AUTH_USER_ID=local-user
# WEAVE_AUTH_USER_NAME=Local User
#
# WEAVE_AUTH_TOKENS is intentionally unsupported for multiple users.
# A single-entry legacy map is accepted as a migration fallback and becomes the owner token.
# If left in an old .env alongside WEAVE_OWNER_TOKEN or WEAVE_AUTH_TOKEN, it is ignored.

# Deprecated persistence envs from the libSQL era are intentionally not used at runtime:
# WEAVE_METADATA_DATABASE_URL, TURSO_DATABASE_URL, TURSO_AUTH_TOKEN, MASTRA_STORAGE_URL,
# MASTRA_STORAGE_AUTH_TOKEN.
